# Copy to .env (`cp .env.example .env`) and edit. docker compose reads .env from this directory
# automatically; nothing else needs to be passed on the command line.

# --- required when the https profile is on -------------------------------------
# The hostname this deployment answers to. Its A/AAAA record must point at this machine, and
# ports 80 and 443 must reach it: 80 for the certificate challenge, 443 for the reader.
NOVARA_DOMAIN=novara.example.com

# --- strongly recommended ------------------------------------------------------
# The same hostname, as a host allow-list. While this is empty the server performs no Host
# filtering at all, so leave it set. Comma-separated, hostnames only - an entry carrying a port
# never matches a request and the server warns about it at startup.
NOVARA_SYNC_ALLOWED_HOSTS=novara.example.com

# --- optional ------------------------------------------------------------------
# Per-space storage quota in bytes. Default 524288000 (500 MiB).
#NOVARA_SYNC_QUOTA_BYTES=524288000
# Versions retained per file. Default 10.
#NOVARA_SYNC_MAX_VERSIONS=10

# --- change only with a reason -------------------------------------------------
# Proxies whose forwarding headers the server believes. Addresses are as the container sees them.
# The defaults are:
#   172.28.0.250  the Caddy container (pinned at the top of the subnet - see the network block in
#                 docker-compose.yml for why it is not the low address you would expect)
#   172.28.0.1    this compose network's gateway, i.e. anything arriving through the published
#                 loopback port - the Tailscale / Cloudflare-tunnel shape, where the terminator runs
#                 on the host rather than in a container
# Single addresses only; CIDR is not accepted. An address listed here can declare the request's
# scheme, so list the proxies you actually run and nothing else.
#NOVARA_SYNC_TRUSTED_PROXIES=172.28.0.250,172.28.0.1

# Pin the image by digest once you have one you trust.
#NOVARA_IMAGE=ghcr.io/novara-owner/novara-sync:9.0.0
