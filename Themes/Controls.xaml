                                        <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.14" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="PointerOver">
