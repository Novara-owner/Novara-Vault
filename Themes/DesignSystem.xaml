<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <CornerRadius x:Key="CornerRadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="CornerRadiusMedium">8</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">14</CornerRadius>
    <CornerRadius x:Key="CornerRadiusXLarge">20</CornerRadius>

    <x:Double x:Key="SpacingXs">4</x:Double>
    <x:Double x:Key="SpacingSm">8</x:Double>
    <x:Double x:Key="SpacingMd">16</x:Double>
    <x:Double x:Key="SpacingLg">24</x:Double>
    <x:Double x:Key="SpacingXl">32</x:Double>

    <x:Double x:Key="TitleBarHeight">36</x:Double>

    <x:Double x:Key="ShadowOffsetX">0</x:Double>
    <x:Double x:Key="ShadowOffsetY">2</x:Double>
    <x:Double x:Key="ShadowBlurSmall">8</x:Double>
    <x:Double x:Key="ShadowBlurMedium">16</x:Double>
    <x:Double x:Key="ShadowBlurLarge">24</x:Double>

    <x:Double x:Key="FontSizeSmall">12</x:Double>
    <x:Double x:Key="FontSizeMedium">14</x:Double>
    <x:Double x:Key="FontSizeLarge">16</x:Double>
    <x:Double x:Key="FontSizeXLarge">20</x:Double>
    <x:Double x:Key="FontSizeTitle">24</x:Double>

</ResourceDictionary>
