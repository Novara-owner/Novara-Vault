                            <Path Data="M278.528 278.528L745.472 745.472M745.472 278.528L278.528 745.472"
                                  Stroke="{ThemeResource IconForegroundBrush}" StrokeThickness="1.8" Stretch="Uniform" Width="16" Height="16" />
