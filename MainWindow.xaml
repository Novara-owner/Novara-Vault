                                    <Grid Width="400" Height="38">
                                        <Viewbox Width="400" Height="38" Stretch="Uniform" Opacity="0.45">
                                            <Border Width="800" Height="76" CornerRadius="12"
                                                    Background="{ThemeResource AppSurfaceOverlayBrush}"
                                                    BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="1" Padding="20,18">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
