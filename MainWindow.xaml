                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource NovaraPrimaryButtonStyle}" Width="160" Height="40" CornerRadius="10" IsTabStop="False" IsHitTestVisible="False">
                                                        <TextBlock x:Name="CarouselLockHelloText" HorizontalAlignment="Center" VerticalAlignment="Center" />
