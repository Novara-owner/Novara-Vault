<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Novara.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Novara"
    xmlns:services="using:Novara.Services"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Novara"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource AppSurfaceBrush}">

        <Grid.Resources>





            <Style x:Key="CarouselDemoDropdownButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource AppSurfaceBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource AppTextSecondaryBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource AppBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="{TemplateBinding Background}"
                                  BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}"
                                  CornerRadius="{TemplateBinding CornerRadius}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>



            <Style x:Key="SealTextButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource AppTextSecondaryBrush}" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Content" Storyboard.TargetProperty="Foreground">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource AppTextPrimaryBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource AppHoverBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter x:Name="Content" Content="{TemplateBinding Content}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Foreground="{TemplateBinding Foreground}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SealUnlockPasswordBoxStyle" TargetType="PasswordBox">
                <Setter Property="Height" Value="48" />


                <Setter Property="MaxLength" Value="128" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Padding" Value="16,0,44,0" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Background" Value="{ThemeResource AppSurfaceOverlayBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource AppBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="PasswordBox">
                            <Grid>
                                <Border x:Name="BorderElement"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="{TemplateBinding CornerRadius}">
                                    <Grid>
                                        <ScrollViewer x:Name="ContentElement"
                                                      Margin="{TemplateBinding Padding}"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Center"
                                                      FontSize="{TemplateBinding FontSize}"
                                                      HorizontalScrollBarVisibility="Hidden"
                                                      VerticalScrollBarVisibility="Hidden"
                                                      IsTabStop="False" />
                                        <TextBlock x:Name="PlaceholderTextBlock"
                                                   Text="{TemplateBinding PlaceholderText}"
                                                   Foreground="{ThemeResource AppTextTertiaryBrush}"
                                                   FontSize="{TemplateBinding FontSize}"
                                                   HorizontalAlignment="Stretch"
                                                   VerticalAlignment="Center"
                                                   Margin="{TemplateBinding Padding}"
                                                   IsHitTestVisible="False"
                                                   Visibility="Collapsed" />
                                        <Button x:Name="RevealButton" Tag="A11y_RevealPassword"
                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Width="36" Height="36" Margin="0,0,4,0"
                                                Background="Transparent" BorderThickness="0"
                                                Visibility="Collapsed">
                                            <FontIcon x:Name="RevealIcon" Glyph="&#xE890;" FontSize="14" />
                                        </Button>
                                    </Grid>
                                </Border>



                                <Border x:Name="StateRing"
                                        BorderBrush="{ThemeResource AppPrimaryButtonBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="{TemplateBinding CornerRadius}"
                                        Opacity="0"
                                        IsHitTestVisible="False" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="StateRing" Storyboard.TargetProperty="Opacity" To="0" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="StateRing" Storyboard.TargetProperty="BorderBrush">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource AppTextTertiaryBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <DoubleAnimation Storyboard.TargetName="StateRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Focused">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="StateRing" Storyboard.TargetProperty="BorderBrush">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource AppPrimaryButtonBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <DoubleAnimation Storyboard.TargetName="StateRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="StateRing" Storyboard.TargetProperty="BorderBrush">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource AppBorderBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <DoubleAnimation Storyboard.TargetName="StateRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="PasswordStates">
                                        <VisualState x:Name="RevealingHidden" />
                                        <VisualState x:Name="Revealing">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RevealButton" Storyboard.TargetProperty="Visibility">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="Visible" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>


                                    <VisualStateGroup x:Name="ValidationStates">
                                        <VisualState x:Name="Valid">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="StateRing" Storyboard.TargetProperty="Visibility">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="Visible" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Invalid">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BorderElement" Storyboard.TargetProperty="BorderBrush">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource AppDangerTextBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="StateRing" Storyboard.TargetProperty="Visibility">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="Collapsed" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="CustomTitleBar" Background="Transparent">




            <Button x:Name="TitleBrandButton"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="16,0,0,0"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    IsTabStop="False"
                    Click="TitleBrandButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver" />
                                    <VisualState x:Name="Pressed" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock
                    x:Name="TitleBrandText"
                    Text="Novara"
                    FontFamily="Assets/Fonts/Comfortaa.ttf#Comfortaa"
                    FontSize="15"
                    Foreground="{ThemeResource AppPrimaryButtonBrush}" />
            </Button>



            <Button x:Name="WorkspaceSwitcherButton"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,135,0"
                    Height="28"
                    Background="Transparent"
                    BorderThickness="0"
                    CornerRadius="8"
                    Padding="8,0"
                    Visibility="Collapsed"
                    IsTabStop="False"
                    Click="WorkspaceSwitcherButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">

                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver" />
                                    <VisualState x:Name="Pressed" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Viewbox Width="16" Height="16" Stretch="Uniform">
                        <PathIcon x:Name="WorkspaceSwitcherIcon" Foreground="{ThemeResource IconForegroundBrush}" />
                    </Viewbox>
                    <TextBlock x:Name="WorkspaceSwitcherText" VerticalAlignment="Center" FontSize="13" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid x:Name="NavBar" Grid.Row="1" Margin="64,0,64,8" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="NavShadowReceiver" Grid.ColumnSpan="4" IsHitTestVisible="False" />




            <Border x:Name="NavIndicator" Grid.ColumnSpan="4" Height="26" VerticalAlignment="Bottom"
                    HorizontalAlignment="Left" CornerRadius="16" IsHitTestVisible="False"
                    Opacity="0">
                <Border.Background>

                    <RadialGradientBrush Center="0.5,0.35" RadiusX="0.5" RadiusY="0.65">
                        <GradientStop Color="#8C7276FF" Offset="0" />
                        <GradientStop Color="#667276FF" Offset="0.5" />
                        <GradientStop Color="#2D7276FF" Offset="0.75" />
                        <GradientStop Color="#007276FF" Offset="1" />
                    </RadialGradientBrush>
                </Border.Background>
                <Border.RenderTransform><TranslateTransform x:Name="NavIndicatorTranslate" Y="8" /></Border.RenderTransform>
            </Border>
            <Grid x:Name="NavMemoHost" Grid.Column="0" Margin="8,0,8,0">
                <Button x:Name="NavMemo" Style="{StaticResource NovaraNavButtonStyle}" Click="NavButton_Click" Tag="Memo" IsTabStop="False">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Path x:Name="NavMemoPath" Width="20" Height="20" Stretch="Uniform"
                              Fill="{ThemeResource IconForegroundBrush}" />
                        <TextBlock x:Name="NavMemoText" Text="备忘" Tag="Nav_Tab_Memo" VerticalAlignment="Center" FontSize="14" />
                    </StackPanel>
                </Button>
            </Grid>
            <Grid x:Name="NavFileHost" Grid.Column="1" Margin="8,0,8,0">
                <Button x:Name="NavFile" Style="{StaticResource NovaraNavButtonStyle}" Click="NavButton_Click" Tag="File" IsTabStop="False">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Path x:Name="NavFilePath" Width="20" Height="20" Stretch="Uniform"
                              Fill="{ThemeResource IconForegroundBrush}" />
                        <TextBlock x:Name="NavFileText" Text="文件" Tag="Nav_Tab_File" VerticalAlignment="Center" FontSize="14" />
                    </StackPanel>
                </Button>
            </Grid>
            <Grid x:Name="NavPlanHost" Grid.Column="2" Margin="8,0,8,0">
                <Button x:Name="NavPlan" Style="{StaticResource NovaraNavButtonStyle}" Click="NavButton_Click" Tag="Plan" IsTabStop="False">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Path x:Name="NavPlanPath" Width="20" Height="20" Stretch="Uniform"
                              Fill="{ThemeResource IconForegroundBrush}" />
                        <TextBlock x:Name="NavPlanText" Text="计划" Tag="Nav_Tab_Plan" VerticalAlignment="Center" FontSize="14" />
                    </StackPanel>
                </Button>
                <Button Tag="A11y_PlanFilter" x:Name="NavPlanFilterButton"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,10,0"
                        Width="28" Height="28"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="8"
                        Padding="0"
                        Visibility="Collapsed"
                        IsTabStop="False"
                        Click="NavPlanFilterButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource AppHoverBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource AppHoverBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </ControlTemplate>
                    </Button.Template>
                    <Viewbox Width="14" Height="14" Stretch="Uniform">
                        <PathIcon x:Name="NavPlanFilterIcon" Foreground="{ThemeResource IconForegroundBrush}" />
                    </Viewbox>
                </Button>
            </Grid>
            <Grid x:Name="NavDiaryHost" Grid.Column="3" Margin="8,0,8,0">
                <Button x:Name="NavDiary" Style="{StaticResource NovaraNavButtonStyle}" Click="NavButton_Click" Tag="Diary" IsTabStop="False">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Path x:Name="NavDiaryPath" Width="20" Height="20" Stretch="Uniform"
                              Fill="{ThemeResource IconForegroundBrush}" />
                        <TextBlock x:Name="NavDiaryText" Text="记录" Tag="Nav_Tab_Diary" VerticalAlignment="Center" FontSize="14" />
                    </StackPanel>
                </Button>
                <Button Tag="A11y_DiaryFilter" x:Name="NavDiaryFilterButton"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,10,0"
                        Width="28" Height="28"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="8"
                        Padding="0"
                        Visibility="Collapsed"
                        IsTabStop="False"
                        Click="NavDiaryFilterButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource AppHoverBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource AppHoverBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </ControlTemplate>
                    </Button.Template>
                    <Viewbox Width="14" Height="14" Stretch="Uniform">
                        <PathIcon x:Name="NavDiaryFilterIcon" Foreground="{ThemeResource IconForegroundBrush}" />
                    </Viewbox>
                </Button>
            </Grid>
        </Grid>



        <Grid x:Name="SealNavBar" Grid.Row="1" Margin="64,0,64,8" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="SealNavShadowReceiver" Grid.ColumnSpan="3" IsHitTestVisible="False" />

            <Border x:Name="SealNavIndicator" Grid.ColumnSpan="3" Height="26" VerticalAlignment="Bottom"
                    HorizontalAlignment="Left" CornerRadius="16"
                    IsHitTestVisible="False" Opacity="1">
                <Border.Background>
                    <RadialGradientBrush Center="0.5,0.35" RadiusX="0.5" RadiusY="0.65">
                        <GradientStop Color="#8C7276FF" Offset="0" />
                        <GradientStop Color="#667276FF" Offset="0.5" />
                        <GradientStop Color="#2D7276FF" Offset="0.75" />
                        <GradientStop Color="#007276FF" Offset="1" />
                    </RadialGradientBrush>
                </Border.Background>
                <Border.RenderTransform><TranslateTransform x:Name="SealNavIndicatorTranslate" Y="8" /></Border.RenderTransform>
            </Border>
            <Grid x:Name="SealNavSpaceHost" Grid.Column="0">
                <Button x:Name="SealNavSpaceButton" Style="{StaticResource NovaraNavButtonStyle}"
                        Background="{ThemeResource NavFaceRaisedBrush}" IsTabStop="False" Click="SealNavSpace_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Path x:Name="SealNavSpacePath" Width="20" Height="20" Stretch="Uniform"
                              Fill="{ThemeResource AppPrimaryButtonBrush}" />
                        <TextBlock x:Name="SealNavSpaceText" Text="私密空间" Tag="Seal_Tab_Space" VerticalAlignment="Center"
                                   FontSize="14" Foreground="{ThemeResource AppPrimaryButtonBrush}" />
                    </StackPanel>
                </Button>
            </Grid>
            <Grid x:Name="SealNavCapsuleHost" Grid.Column="1">
                <Button x:Name="SealNavCapsule" Style="{StaticResource NovaraNavButtonStyle}" IsTabStop="False" Opacity="0.6" Click="SealNavCapsule_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Path x:Name="SealNavCapsulePath" Width="20" Height="20" Stretch="Uniform" Opacity="0.6"
                              Fill="{ThemeResource IconForegroundBrush}" />
                        <TextBlock x:Name="SealNavCapsuleText" Text="时间胶囊" Tag="Seal_Tab_Capsule" VerticalAlignment="Center"
                                   FontSize="14" Foreground="{ThemeResource AppTextTertiaryBrush}" />
                    </StackPanel>
                </Button>
            </Grid>
            <Grid x:Name="SealNavSettingsHost" Grid.Column="2">
                <Button x:Name="SealNavSettings" Style="{StaticResource NovaraNavButtonStyle}" IsTabStop="False" Opacity="0.6" Click="SealNavSettings_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Path x:Name="SealNavSettingsPath" Width="20" Height="20" Stretch="Uniform" Opacity="0.6"
                              Fill="{ThemeResource IconForegroundBrush}" />
                        <TextBlock x:Name="SealNavSettingsText" Text="设置" Tag="Setting_Title_Page" VerticalAlignment="Center"
                                   FontSize="14" Foreground="{ThemeResource AppTextTertiaryBrush}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>






        <Grid x:Name="ChromeScrim" Grid.Row="0" Grid.RowSpan="2"
              IsHitTestVisible="False" Opacity="0" Visibility="Collapsed">
            <Grid x:Name="ChromeBlurHost" IsHitTestVisible="False" />
            <Border Background="{ThemeResource AppSurfaceBrush}" Opacity="0.3" IsHitTestVisible="False" />
        </Grid>

        <Grid Grid.Row="2">
            <Frame x:Name="RootFrame" />

            <Grid x:Name="WelcomeOverlay" Visibility="Visible" Background="{ThemeResource AppSurfaceBrush}" Tapped="WelcomeOverlay_Tapped">

                <Grid.Resources>





                    <Storyboard x:Name="WelcomeEntryAnimation">
                        <DoubleAnimation Storyboard.TargetName="WelcomeLogo" Storyboard.TargetProperty="Opacity"
                                         From="0" To="1" Duration="0:0:0.9" BeginTime="0:0:0.1">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="WelcomeLogoTransform" Storyboard.TargetProperty="ScaleX"
                                         From="0.94" To="1" Duration="0:0:1.1" BeginTime="0:0:0.1">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="WelcomeLogoTransform" Storyboard.TargetProperty="ScaleY"
                                         From="0.94" To="1" Duration="0:0:1.1" BeginTime="0:0:0.1">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="WelcomeTitleGroup" Storyboard.TargetProperty="Opacity"
                                         From="0" To="1" Duration="0:0:0.8" BeginTime="0:0:0.45">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="WelcomeSubtitle" Storyboard.TargetProperty="Opacity"
                                         From="0" To="1" Duration="0:0:0.8" BeginTime="0:0:0.7">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="WelcomeHintGroup" Storyboard.TargetProperty="Opacity"
                                         From="0" To="1" Duration="0:0:0.8" BeginTime="0:0:0.95">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="WelcomeVersionBadge" Storyboard.TargetProperty="Opacity"
                                         From="0" To="0.55" Duration="0:0:0.6" BeginTime="0:0:1.2">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </Grid.Resources>


                <Image x:Name="WelcomeLogo"
                       Source="ms-appx:///Assets/Novara-R.png"
                       Width="96" Height="96"
                       Stretch="Uniform"
                       Opacity="0"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center">
                    <Image.RenderTransform>
                        <CompositeTransform x:Name="WelcomeLogoTransform" ScaleX="1" ScaleY="1" TranslateY="0" />
                    </Image.RenderTransform>
                </Image>

                <Grid x:Name="WelcomeTitleGroup"
                      Opacity="0"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="WelcomeTitleTransform" X="0" Y="0" />
                    </Grid.RenderTransform>

                    <TextBlock x:Name="WelcomeTitleShadowText"
                               Text="Novara"
                               FontFamily="Assets/Fonts/Comfortaa.ttf#Comfortaa"
                               FontSize="32"
                               Foreground="{ThemeResource AppTextPrimaryBrush}"
                               Opacity="0.06"
                               Margin="1,1,0,0" />
                    <TextBlock x:Name="WelcomeTitleText"
                               Text="Novara"
                               FontFamily="Assets/Fonts/Comfortaa.ttf#Comfortaa"
                               FontSize="32"
                               Foreground="{ThemeResource AppTextPrimaryBrush}" />
                </Grid>



                <TextBlock x:Name="WelcomeSubtitle"
                           Text="本地优先 · 为你与 AI 保管" Tag="Welcome_Subtitle"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="16"
                           FontWeight="Normal"
                           Foreground="{ThemeResource AppTextSecondaryBrush}"
                           CharacterSpacing="180"
                           Opacity="0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                    <TextBlock.RenderTransform>
