                                        <Border Height="24" VerticalAlignment="Top">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="{ThemeResource CarouselFadeColor}" Offset="0" />
                                                    <GradientStop Color="#00FFFFFF" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                    
                                    <Viewbox Width="480" Height="45.6" Stretch="Uniform">
                                        <Border Width="800" Height="76" CornerRadius="12"
                                                Background="{ThemeResource AppSurfaceOverlayBrush}"
                                                BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="1" Padding="20,18">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="CarouselLockTitle" FontSize="16" FontWeight="SemiBold"
                                                           Foreground="{ThemeResource AppTextPrimaryBrush}"
