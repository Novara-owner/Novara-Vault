                                                        <TextBlock x:Name="CarouselArchiveButtonText" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </Viewbox>
                                        <Border Height="24" VerticalAlignment="Bottom">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#00FFFFFF" Offset="0" />
                                                    <GradientStop Color="{ThemeResource CarouselFadeColor}" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                                
                                <TextBlock x:Name="CarouselP3Intro" FontSize="14"
                                           Foreground="{ThemeResource AppTextSecondaryBrush}"
                                           TextWrapping="Wrap" TextAlignment="Center" MaxWidth="500"
                                           HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                           Margin="40,0,40,40" Height="42" />
                            </Grid>
                        </Grid>
                        <Button x:Name="CarouselCloseButton" HorizontalAlignment="Right" VerticalAlignment="Top"
