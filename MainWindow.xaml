                                                        <Button Style="{StaticResource CarouselDemoDropdownButtonStyle}" Width="160" Height="40" IsTabStop="False" IsHitTestVisible="False">
                                                            <TextBlock x:Name="CarouselMcpConfigText" HorizontalAlignment="Center" VerticalAlignment="Center" />
