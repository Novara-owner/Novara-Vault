                                        <TransformGroup>
                                            <RotateTransform Angle="2" />
                                            <TranslateTransform x:Name="CarouselP1FloatT2" />
                                        </TransformGroup>
                                    </Button.RenderTransform>
                                </Button>
                                <Button x:Name="CarouselP1BtnDiary" Style="{StaticResource NovaraNavButtonStyle}" Tag="Carousel_P1_Diary"
