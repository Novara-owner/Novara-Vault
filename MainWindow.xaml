                        BorderThickness="2">
                    <Grid>
                        <Grid x:Name="CarouselPages">
                        <Grid x:Name="CarouselPage0" Visibility="Visible">
                            <StackPanel Margin="30,30,30,0">
                                <TextBlock x:Name="CarouselP0Title"
                                           FontSize="20" FontWeight="SemiBold"
                                           Foreground="{ThemeResource AppTextPrimaryBrush}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                            

                            <Border x:Name="CarouselMenuMemo" MinWidth="230" CornerRadius="16" Padding="6"
                                    Background="{ThemeResource AppSurfaceElevatedBrush}" BorderBrush="{ThemeResource AppDialogBorderBrush}" BorderThickness="1"
