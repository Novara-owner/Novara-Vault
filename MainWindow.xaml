                    </Grid>
                </Border>
                <StackPanel x:Name="CarouselDots" Orientation="Horizontal" Spacing="10"
                            HorizontalAlignment="Center" Margin="0,18,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
