                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Path x:Name="CarouselP5SyncIcon" Width="18" Height="18" Stretch="Uniform"
                                              Fill="{ThemeResource AppPrimaryButtonBrush}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="CarouselP5SyncTitle" FontSize="17" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock x:Name="CarouselP5SyncDesc" FontSize="13.5"
                                               Foreground="{ThemeResource AppTextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="CarouselP5Body" Grid.Row="2" FontSize="15"
                                   Foreground="{ThemeResource AppTextSecondaryBrush}"
                                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="660"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,34" />
                    </Grid>



                    <Grid x:Name="CarouselPage6" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="680">
                            <Image Source="ms-appx:///Assets/Novara-R.png" Width="92" Height="92" Stretch="Uniform"
                                   HorizontalAlignment="Center" Margin="0,0,0,26" />
                            <TextBlock x:Name="CarouselP6B1" FontSize="21" FontWeight="SemiBold"
                                       Foreground="{ThemeResource AppTextPrimaryBrush}"
                                       HorizontalAlignment="Center" Margin="0,0,0,14" />
                            <TextBlock x:Name="CarouselP6B2" FontSize="15"
                                       Foreground="{ThemeResource AppTextSecondaryBrush}"
                                       TextWrapping="Wrap" TextAlignment="Center"
                                       HorizontalAlignment="Center" Margin="0,0,0,10" />
                            <TextBlock x:Name="CarouselP6B3" FontSize="14"
                                       Foreground="{ThemeResource AppTextSecondaryBrush}"
                                       TextWrapping="Wrap" TextAlignment="Center"
                                       HorizontalAlignment="Center" Margin="0,0,0,26" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="40">
                                <HyperlinkButton x:Name="CarouselP6GitHubLink"
                                                 NavigateUri="https://github.com/Novara-owner/Novara-Vault"
                                                 Foreground="{ThemeResource AppPrimaryButtonBrush}" FontSize="14" />
                                <HyperlinkButton NavigateUri="mailto:owner@novara.xin" Content="owner@novara.xin"
                                                 Foreground="{ThemeResource AppPrimaryButtonBrush}" FontSize="14" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>


                <TextBlock x:Name="CarouselSkipButton" FontSize="14"
                           Foreground="{ThemeResource AppTextTertiaryBrush}"
                           HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="48,0,0,44"
                           Tapped="CarouselSkip_Tapped" />
                <Button x:Name="CarouselNextButton" Style="{StaticResource NovaraPrimaryButtonStyle}"
                        MinWidth="300" Height="54" FontSize="16" CornerRadius="16"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,36"
                        Click="CarouselNext_Click">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Enter" />
                    </Button.KeyboardAccelerators>
                </Button>
            </Grid>




            <Grid x:Name="CarouselMeltLayer" IsHitTestVisible="False" Visibility="Collapsed">
                <Ellipse x:Name="CarouselMeltBlob0" Width="160" Height="160" Opacity="0"
                         HorizontalAlignment="Left" VerticalAlignment="Top" />
                <Ellipse x:Name="CarouselMeltBlob1" Width="160" Height="160" Opacity="0"
                         HorizontalAlignment="Left" VerticalAlignment="Top" />
                <Ellipse x:Name="CarouselMeltBlob2" Width="160" Height="160" Opacity="0"
                         HorizontalAlignment="Left" VerticalAlignment="Top" />
            </Grid>
        </Grid>
    </Grid>
</Window>
