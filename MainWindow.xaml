                                              Fill="#FFFFFFFF" Opacity="0" />
                                    </Border>
                                </Grid>
                                <Path x:Name="CarouselDemoCursor" Width="26" Height="28" Stretch="Uniform"
                                      Fill="#FFFFFFFF" Stroke="#E6333333" StrokeThickness="1.2" StrokeLineJoin="Round"
                                      Data="M0,0 L0,16.9 L4.6,13 L7.5,19.2 L10.3,18 L7.4,11.7 L12.8,11.7 Z"
                                      HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <Path.RenderTransform>
