<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Novara.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Novara"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Novara"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource AppSurfaceBrush}">

        <Grid.Resources>





            <Style x:Key="CarouselDemoDropdownButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource AppSurfaceBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource AppTextSecondaryBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource AppBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="{TemplateBinding Background}"
                                  BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}"
                                  CornerRadius="{TemplateBinding CornerRadius}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="CustomTitleBar" Background="Transparent">
            <TextBlock
                Text="Novara"
                FontFamily="Assets/Fonts/Comfortaa.ttf#Comfortaa"
                VerticalAlignment="Center"
                Margin="16,0,0,0"
                FontSize="15"
                Foreground="{ThemeResource AppPrimaryButtonBrush}" />



            <Button x:Name="WorkspaceSwitcherButton"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,135,0"
                    Height="28"
                    Background="Transparent"
                    BorderThickness="0"
                    CornerRadius="8"
                    Padding="8,0"
                    Visibility="Collapsed"
                    IsTabStop="False"
                    Click="WorkspaceSwitcherButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">

                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver" />
                                    <VisualState x:Name="Pressed" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Viewbox Width="16" Height="16" Stretch="Uniform">
                        <PathIcon x:Name="WorkspaceSwitcherIcon" Foreground="{ThemeResource IconForegroundBrush}" />
                    </Viewbox>
                    <TextBlock x:Name="WorkspaceSwitcherText" VerticalAlignment="Center" FontSize="13" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid x:Name="NavBar" Grid.Row="1" Margin="60,4,60,8" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="NavShadowReceiver" Grid.ColumnSpan="4" IsHitTestVisible="False" />




            <Border x:Name="NavIndicator" Grid.ColumnSpan="4" Height="26" VerticalAlignment="Bottom"
                    HorizontalAlignment="Left" CornerRadius="16" IsHitTestVisible="False"
                    Opacity="0">
                <Border.Background>

                    <RadialGradientBrush Center="0.5,0.35" RadiusX="0.5" RadiusY="0.65">
                        <GradientStop Color="#8C7276FF" Offset="0" />
                        <GradientStop Color="#667276FF" Offset="0.5" />
                        <GradientStop Color="#2D7276FF" Offset="0.75" />
                        <GradientStop Color="#007276FF" Offset="1" />
                    </RadialGradientBrush>
                </Border.Background>
                <Border.RenderTransform><TranslateTransform x:Name="NavIndicatorTranslate" Y="8" /></Border.RenderTransform>
            </Border>
            <Grid x:Name="NavMemoHost" Grid.Column="0" Margin="0,0,10,0">
                <Button x:Name="NavMemo" Style="{StaticResource NovaraNavButtonStyle}" Click="NavButton_Click" Tag="Memo" IsTabStop="False">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Path x:Name="NavMemoPath" Width="20" Height="20" Stretch="Uniform"
                              Fill="{ThemeResource IconForegroundBrush}" />
                        <TextBlock x:Name="NavMemoText" Text="备忘" Tag="Nav_Tab_Memo" VerticalAlignment="Center" FontSize="14" />
                    </StackPanel>
                </Button>
            </Grid>
            <Grid x:Name="NavFileHost" Grid.Column="1" Margin="0,0,10,0">
                <Button x:Name="NavFile" Style="{StaticResource NovaraNavButtonStyle}" Click="NavButton_Click" Tag="File" IsTabStop="False">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Path x:Name="NavFilePath" Width="20" Height="20" Stretch="Uniform"
                              Fill="{ThemeResource IconForegroundBrush}" />
                        <TextBlock x:Name="NavFileText" Text="文件" Tag="Nav_Tab_File" VerticalAlignment="Center" FontSize="14" />
                    </StackPanel>
                </Button>
            </Grid>
            <Grid x:Name="NavPlanHost" Grid.Column="2" Margin="0,0,10,0">
                <Button x:Name="NavPlan" Style="{StaticResource NovaraNavButtonStyle}" Click="NavButton_Click" Tag="Plan" IsTabStop="False">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Path x:Name="NavPlanPath" Width="20" Height="20" Stretch="Uniform"
                              Fill="{ThemeResource IconForegroundBrush}" />
                        <TextBlock x:Name="NavPlanText" Text="计划" Tag="Nav_Tab_Plan" VerticalAlignment="Center" FontSize="14" />
                    </StackPanel>
                </Button>
                <Button x:Name="NavPlanFilterButton"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,10,0"
                        Width="28" Height="28"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="8"
                        Padding="0"
                        Visibility="Collapsed"
                        IsTabStop="False"
                        Click="NavPlanFilterButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource AppHoverBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource AppHoverBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </ControlTemplate>
                    </Button.Template>
                    <Viewbox Width="14" Height="14" Stretch="Uniform">
                        <PathIcon x:Name="NavPlanFilterIcon" Foreground="{ThemeResource IconForegroundBrush}" />
                    </Viewbox>
                </Button>
            </Grid>
            <Grid x:Name="NavDiaryHost" Grid.Column="3">
                <Button x:Name="NavDiary" Style="{StaticResource NovaraNavButtonStyle}" Click="NavButton_Click" Tag="Diary" IsTabStop="False">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Path x:Name="NavDiaryPath" Width="20" Height="20" Stretch="Uniform"
                              Fill="{ThemeResource IconForegroundBrush}" />
                        <TextBlock x:Name="NavDiaryText" Text="记录" Tag="Nav_Tab_Diary" VerticalAlignment="Center" FontSize="14" />
                    </StackPanel>
                </Button>
                <Button x:Name="NavDiaryFilterButton"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,10,0"
                        Width="28" Height="28"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="8"
                        Padding="0"
                        Visibility="Collapsed"
                        IsTabStop="False"
                        Click="NavDiaryFilterButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource AppHoverBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource AppHoverBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </ControlTemplate>
                    </Button.Template>
                    <Viewbox Width="14" Height="14" Stretch="Uniform">
                        <PathIcon x:Name="NavDiaryFilterIcon" Foreground="{ThemeResource IconForegroundBrush}" />
                    </Viewbox>
                </Button>
            </Grid>
        </Grid>




        <Grid x:Name="ChromeScrim" Grid.Row="0" Grid.RowSpan="2"
              IsHitTestVisible="False" Opacity="0" Visibility="Collapsed">
            <Grid x:Name="ChromeBlurHost" IsHitTestVisible="False" />
            <Border Background="{ThemeResource AppSurfaceBrush}" Opacity="0.3" IsHitTestVisible="False" />
        </Grid>

        <Grid Grid.Row="2">
            <Frame x:Name="RootFrame" />

            <Grid x:Name="WelcomeOverlay" Visibility="Visible" Background="{ThemeResource AppSurfaceBrush}" Tapped="WelcomeOverlay_Tapped">

                <Grid.Resources>

                    <Storyboard x:Name="WelcomeEntryAnimation">
                        <DoubleAnimation Storyboard.TargetName="WelcomeLogo" Storyboard.TargetProperty="Opacity"
                                         From="0" To="1" Duration="0:0:1.8" BeginTime="0:0:0.3">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="WelcomeTitleTransform" Storyboard.TargetProperty="X"
                                         From="-100" To="0" Duration="0:0:1.5" BeginTime="0:0:0.7">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="WelcomeTitleGroup" Storyboard.TargetProperty="Opacity"
                                         From="0" To="1" Duration="0:0:1.2" BeginTime="0:0:0.7">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="WelcomeSubtitleTransform" Storyboard.TargetProperty="X"
                                         From="100" To="0" Duration="0:0:1.5" BeginTime="0:0:1.1">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="WelcomeSubtitle" Storyboard.TargetProperty="Opacity"
                                         From="0" To="1" Duration="0:0:1.2" BeginTime="0:0:1.1">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="WelcomeHint" Storyboard.TargetProperty="Opacity"
                                         From="0" To="0.5" Duration="0:0:1.6" BeginTime="0:0:1.7">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>

                    <Storyboard x:Name="WelcomeHintBreathing" RepeatBehavior="Forever" AutoReverse="True">
                        <DoubleAnimation Storyboard.TargetName="WelcomeHint" Storyboard.TargetProperty="Opacity"
                                         From="0.3" To="0.7" Duration="0:0:3.0">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseInOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </Grid.Resources>


                <Image x:Name="WelcomeLogo"
                       Source="ms-appx:///Assets/Novara-R.png"
                       Width="80" Height="80"
                       Stretch="Uniform"
                       Opacity="0"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center">
                    <Image.RenderTransform>
                        <TranslateTransform x:Name="WelcomeLogoTransform" Y="0" />
                    </Image.RenderTransform>
                </Image>

                <Grid x:Name="WelcomeTitleGroup"
                      Opacity="0"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="WelcomeTitleTransform" X="0" Y="0" />
                    </Grid.RenderTransform>
                    <TextBlock x:Name="WelcomeTitleShadowText"
                               Text="Novara"
                               FontFamily="Assets/Fonts/Comfortaa.ttf#Comfortaa"
                               FontSize="80"
                               Foreground="{ThemeResource AppTextPrimaryBrush}"
                               Opacity="0.06"
                               Margin="2,2,0,0" />
                    <TextBlock x:Name="WelcomeTitleText"
                               Text="Novara"
                               FontFamily="Assets/Fonts/Comfortaa.ttf#Comfortaa"
                               FontSize="80"
                               Foreground="{ThemeResource AppTextPrimaryBrush}" />
                </Grid>

                <TextBlock x:Name="WelcomeSubtitle"
                           Text="本地保管每一份私密备忘" Tag="Welcome_Subtitle"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="34"
                           FontWeight="ExtraLight"
                           Foreground="{ThemeResource AppTextSecondaryBrush}"
                           CharacterSpacing="850"
                           Opacity="0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="WelcomeSubtitleTransform" X="0" Y="0" />
                    </TextBlock.RenderTransform>
                </TextBlock>

                <TextBlock x:Name="WelcomeHint"
                           Text="点击任意处开始" Tag="Welcome_Hint_ClickToStart"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="14"
                           Foreground="{ThemeResource AppTextTertiaryBrush}"
                           Opacity="0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="WelcomeHintTransform" Y="0" />
                    </TextBlock.RenderTransform>
                </TextBlock>
            </Grid>
        </Grid>



        <Grid x:Name="BottomToolbarPanel" Grid.Row="2"
              HorizontalAlignment="Left" VerticalAlignment="Bottom"
              Margin="0,0,0,20">
            <Border x:Name="MenuSidePanel"
                    VerticalAlignment="Bottom"
                    Visibility="Collapsed"
                    Background="{ThemeResource AppPrimaryButtonBrush}"
                    CornerRadius="0,12,12,0"
                    Padding="10,8"
                    MinWidth="118"
>
                <Border.RenderTransform>
                    <TranslateTransform x:Name="MenuSidePanelTranslate" X="0" />
                </Border.RenderTransform>
                <StackPanel x:Name="MenuSideItems" Spacing="2" />
            </Border>
            <Border x:Name="MenuHandleBar" Width="6" Height="56"
                    HorizontalAlignment="Left" VerticalAlignment="Bottom"
                    Background="{ThemeResource AppPrimaryButtonBrush}" CornerRadius="0,3,3,0">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="MenuHandleBarTranslate" X="0" />
                </Border.RenderTransform>
            </Border>

            <Button x:Name="MenuButton"
                    Width="24" Height="56"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    IsTabStop="False"
                    Background="Transparent"
                    PointerEntered="MenuButton_PointerEntered">
                <Button.RenderTransform>
                    <TranslateTransform x:Name="MenuButtonTranslate" X="0" />
                </Button.RenderTransform>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent" />
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>


        <Grid x:Name="QuickCaptureOverlay" Visibility="Collapsed" Grid.RowSpan="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid x:Name="QuickCaptureScrim" Background="#2E000000" Tapped="QuickCaptureScrim_Tapped" />
            <Border x:Name="QuickCaptureBar" HorizontalAlignment="Center" VerticalAlignment="Center" Width="520" CornerRadius="24"
                    Background="{ThemeResource AppDialogBgBrush}" BorderBrush="{ThemeResource AppDialogBorderBrush}" BorderThickness="1" Opacity="0">
                <Border.RenderTransform>
                    <CompositeTransform x:Name="QuickCaptureTransform" ScaleX="0.92" ScaleY="0.92" TranslateY="20" />
                </Border.RenderTransform>
                <Grid Padding="28,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                        <Button x:Name="QcModeMemo" Style="{StaticResource NovaraOutlineButtonStyle}" Width="104" Height="36" CornerRadius="10" FontSize="13" Click="QcModeButton_Click" />
                        <Button x:Name="QcModeTodo" Style="{StaticResource NovaraOutlineButtonStyle}" Width="104" Height="36" CornerRadius="10" FontSize="13" Click="QcModeButton_Click" />
                        <Button x:Name="QcModeNote" Style="{StaticResource NovaraOutlineButtonStyle}" Width="104" Height="36" CornerRadius="10" FontSize="13" Click="QcModeButton_Click" />
                    </StackPanel>
                    <TextBox x:Name="QuickCaptureBox" Grid.Row="1" Style="{StaticResource NovaraSearchBoxStyle}" Margin="0,18,0,0"
                             MaxLength="500" KeyDown="QuickCaptureBox_KeyDown" />
                    <TextBlock x:Name="QuickCaptureHint" Grid.Row="2" HorizontalAlignment="Center" Margin="0,14,0,0"
                               FontSize="12" Foreground="{ThemeResource AppTextTertiaryBrush}" TextWrapping="Wrap" />
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="ThemeRestartOverlay" Visibility="Collapsed" Grid.RowSpan="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid x:Name="ThemeRestartScrim" Background="#2E000000" Tapped="ThemeRestartScrim_Tapped" />
            <Border x:Name="ThemeRestartDialog" HorizontalAlignment="Center" VerticalAlignment="Center" Width="420" CornerRadius="24" Background="{ThemeResource AppDialogBgBrush}" BorderBrush="{ThemeResource AppDialogBorderBrush}" BorderThickness="1" Opacity="0">
                <Border.RenderTransform>
                    <CompositeTransform x:Name="ThemeRestartDialogTransform" ScaleX="0.92" ScaleY="0.92" TranslateY="20" />
                </Border.RenderTransform>
                <Grid Padding="28,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <TextBlock Text="检测到系统主题变更" Tag="Theme_Change_Detected"
                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                   FontSize="18" FontWeight="SemiBold"
                                   Foreground="{ThemeResource AppTextPrimaryBrush}" />
                        <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                Width="28" Height="28"
                                Style="{StaticResource NovaraIconButtonStyle}"
                                Click="ThemeRestartClose_Click">
                            <Path Data="M278.528 278.528L745.472 745.472M745.472 278.528L278.528 745.472"
                                  Stroke="{ThemeResource IconForegroundBrush}"
                                  StrokeThickness="1.8" Stretch="Uniform" Width="16" Height="16" />
                        </Button>
                    </Grid>
                    <TextBlock Grid.Row="1"
                               Text="主题将在重启程序后生效，是否立即重启？" Tag="Theme_Restart_ConfirmTip"
                               FontSize="14"
                               Foreground="{ThemeResource AppTextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,20,0,0"
                               LineHeight="22" />
                    <Grid Grid.Row="2" Margin="0,20,0,0">
                        <Button HorizontalAlignment="Left" Width="160" Height="36"
                                Style="{StaticResource NovaraOutlineButtonStyle}"
                                CornerRadius="10" FontSize="14"
                                Click="ThemeRestartCancel_Click">
                            <TextBlock Text="取消" Tag="Common_Button_Cancel" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                        <Button HorizontalAlignment="Right" Width="160" Height="36"
                                Style="{StaticResource NovaraPrimaryButtonStyle}"
                                CornerRadius="10" FontSize="14" FontWeight="SemiBold"
                                Click="ThemeRestartConfirm_Click">
                            <TextBlock Text="确认重启" Tag="Theme_Restart_ConfirmButton" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Frame x:Name="LockScreenFrame" Grid.RowSpan="4" Visibility="Collapsed" />

        <Grid x:Name="StoreCorruptOverlay" Visibility="Collapsed" Grid.RowSpan="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid x:Name="StoreCorruptScrim" Background="#2E000000" />
            <Border x:Name="StoreCorruptDialog" HorizontalAlignment="Center" VerticalAlignment="Center" Width="440" CornerRadius="24" Background="{ThemeResource AppDialogBgBrush}" BorderBrush="{ThemeResource AppDialogBorderBrush}" BorderThickness="1" Opacity="0">
                <Border.RenderTransform>
                    <CompositeTransform x:Name="StoreCorruptDialogTransform" ScaleX="0.92" ScaleY="0.92" TranslateY="20" />
                </Border.RenderTransform>
                <Grid Padding="28,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <Viewbox Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0">
                            <PathIcon x:Name="StoreCorruptDangerIcon" Foreground="{ThemeResource AppDangerTextBrush}" />
                        </Viewbox>
                        <TextBlock x:Name="StoreCorruptTitleText" Text="资料库文件校验失败" Tag="Store_Corrupt_Title"
                                   VerticalAlignment="Center"
                                   FontSize="18" FontWeight="SemiBold"
                                   Foreground="{ThemeResource AppTextPrimaryBrush}" />
                    </StackPanel>
                    <TextBlock x:Name="StoreCorruptDetailText" Grid.Row="1"
                               Text="资料库文件校验失败，文件已损坏或被篡改，程序将重建空白资料库，原有全部数据无法恢复" Tag="Store_Corrupt_Detail"
                               FontSize="14"
                               Foreground="{ThemeResource AppTextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,20,0,0"
                               LineHeight="22" />
                    <Grid Grid.Row="2" Margin="0,24,0,0">
                        <Button x:Name="StoreCorruptConfirmButton" HorizontalAlignment="Center" Width="160" Height="36"
                                Background="{ThemeResource AppDangerBrush}" Foreground="#FFFFFFFF"
                                CornerRadius="10" FontSize="14" FontWeight="SemiBold"
                                BorderThickness="0"
                                Click="StoreCorruptConfirm_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid x:Name="RootGrid" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup x:Name="CommonStates">
                                                <VisualState x:Name="Normal" />
                                                <VisualState x:Name="PointerOver">
                                                    <Storyboard>
                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource AppDangerHoverBrush}" />
                                                        </ObjectAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </VisualState>
                                                <VisualState x:Name="Pressed">
                                                    <Storyboard>
                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource AppDangerPressedBrush}" />
                                                        </ObjectAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </VisualState>
                                                <VisualState x:Name="Disabled" />
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                        <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock x:Name="StoreCorruptConfirmText" Text="重建资料库" Tag="Store_Corrupt_RebuildButton" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="SaveFailedOverlay" Visibility="Collapsed" Grid.RowSpan="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid x:Name="SaveFailedScrim" Background="#2E000000" />
            <Border x:Name="SaveFailedDialog" HorizontalAlignment="Center" VerticalAlignment="Center" Width="440" CornerRadius="24" Background="{ThemeResource AppDialogBgBrush}" BorderBrush="{ThemeResource AppDialogBorderBrush}" BorderThickness="1" Opacity="0">
                <Border.RenderTransform>
                    <CompositeTransform x:Name="SaveFailedDialogTransform" ScaleX="0.92" ScaleY="0.92" TranslateY="20" />
                </Border.RenderTransform>
