<?xml version="1.0" encoding="utf-8" ?>
<Application
    x:Class="Novara.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Novara">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>

                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="IconForegroundBrush" Color="#DDFFFFFF" />
                    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FF1E1E1E" />
                    <SolidColorBrush x:Key="AppSurfaceElevatedBrush" Color="#FF2A2A2A" />
                    <SolidColorBrush x:Key="AppSurfaceOverlayBrush" Color="#FF333333" />
                    <SolidColorBrush x:Key="AppHoverBrush" Color="#FF3D3D3D" />
                    <SolidColorBrush x:Key="AppBorderBrush" Color="#33FFFFFF" />
                    <SolidColorBrush x:Key="NavFaceRaisedBrush" Color="#FF242424" />
                    <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="#DDFFFFFF" />
                    <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="#99FFFFFF" />
                    <SolidColorBrush x:Key="AppTextTertiaryBrush" Color="#66FFFFFF" />
                    <SolidColorBrush x:Key="AppAccentBrush" Color="#FF7276FF" />
                    <SolidColorBrush x:Key="AppAccentPressedBrush" Color="#99FFFFFF" />
                    <SolidColorBrush x:Key="AppPrimaryButtonBrush" Color="#FF7276FF" />
                    <SolidColorBrush x:Key="AppPrimaryButtonHoverBrush" Color="#FF8C93FF" />
                    <SolidColorBrush x:Key="AppPrimaryButtonPressedBrush" Color="#FF5855FF" />
                    <SolidColorBrush x:Key="AppDialogBorderBrush" Color="#FF7276FF" />
                    <LinearGradientBrush x:Key="AppDialogBgBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FF34343C" Offset="0" />
                        <GradientStop Color="#FF27272E" Offset="1" />
                    </LinearGradientBrush>
                    
                    <Color x:Key="CarouselFadeColor">#FF2E2E35</Color>
                </ResourceDictionary>

                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="IconForegroundBrush" Color="#DD000000" />
                    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FFF2F2F2" />
                    <SolidColorBrush x:Key="AppSurfaceElevatedBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="AppSurfaceOverlayBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="AppHoverBrush" Color="#FFE6E6E6" />
                    <SolidColorBrush x:Key="AppBorderBrush" Color="#40000000" />
                    <SolidColorBrush x:Key="NavFaceRaisedBrush" Color="#FFF7F7F7" />
                    <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="#DD000000" />
                    <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="#88000000" />
                    <SolidColorBrush x:Key="AppTextTertiaryBrush" Color="#66000000" />
                    <SolidColorBrush x:Key="AppAccentBrush" Color="#FF7276FF" />
                    <SolidColorBrush x:Key="AppAccentPressedBrush" Color="#CC0066CC" />
                    <SolidColorBrush x:Key="AppPrimaryButtonBrush" Color="#FF7276FF" />
                    <SolidColorBrush x:Key="AppPrimaryButtonHoverBrush" Color="#FF8C93FF" />
                    <SolidColorBrush x:Key="AppPrimaryButtonPressedBrush" Color="#FF5855FF" />
                    <SolidColorBrush x:Key="AppDialogBorderBrush" Color="#FF7276FF" />
                    <LinearGradientBrush x:Key="AppDialogBgBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FFFFFFFF" Offset="0" />
                        <GradientStop Color="#FFF1F1F7" Offset="1" />
                    </LinearGradientBrush>
                    <Color x:Key="CarouselFadeColor">#FFF8F8FB</Color>
                </ResourceDictionary>

                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="IconForegroundBrush" Color="#DDFFFFFF" />
                    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FF1E1E1E" />
                    <SolidColorBrush x:Key="AppSurfaceElevatedBrush" Color="#FF2A2A2A" />
                    <SolidColorBrush x:Key="AppSurfaceOverlayBrush" Color="#FF333333" />
                    <SolidColorBrush x:Key="AppHoverBrush" Color="#FF3D3D3D" />
                    <SolidColorBrush x:Key="AppBorderBrush" Color="#33FFFFFF" />
                    <SolidColorBrush x:Key="NavFaceRaisedBrush" Color="#FF242424" />
                    <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="#DDFFFFFF" />
                    <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="#99FFFFFF" />
                    <SolidColorBrush x:Key="AppTextTertiaryBrush" Color="#66FFFFFF" />
                    <SolidColorBrush x:Key="AppAccentBrush" Color="#FF7276FF" />
                    <SolidColorBrush x:Key="AppAccentPressedBrush" Color="#99FFFFFF" />
                    <SolidColorBrush x:Key="AppPrimaryButtonBrush" Color="#FF7276FF" />
                    <SolidColorBrush x:Key="AppPrimaryButtonHoverBrush" Color="#FF8C93FF" />
                    <SolidColorBrush x:Key="AppPrimaryButtonPressedBrush" Color="#FF5855FF" />
                    <SolidColorBrush x:Key="AppDialogBorderBrush" Color="#FF7276FF" />
                    <LinearGradientBrush x:Key="AppDialogBgBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FF34343C" Offset="0" />
                        <GradientStop Color="#FF27272E" Offset="1" />
                    </LinearGradientBrush>
                    <Color x:Key="CarouselFadeColor">#FF2E2E35</Color>
                </ResourceDictionary>

            </ResourceDictionary.ThemeDictionaries>

            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Themes/DesignSystem.xaml" />
                <ResourceDictionary Source="ms-appx:///Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
