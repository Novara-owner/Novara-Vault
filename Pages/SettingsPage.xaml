    <Grid x:Name="SettingsRoot" Background="{ThemeResource AppSurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="Transparent" Margin="24,20,24,12">
            <Button x:Name="BackButton"
                    Click="BackButton_Click"
                    Width="36" Height="36"
                    Style="{StaticResource NovaraPrimaryButtonStyle}"
                    CornerRadius="8"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center">
                <Path x:Name="BackPathIcon"
                      Width="18" Height="18"
                      Stretch="Uniform"
                      Fill="#FFFFFFFF" />
            </Button>
            <TextBlock x:Name="SettingsTitleText"
                       FontSize="20" FontWeight="SemiBold"
                       Foreground="{ThemeResource AppTextPrimaryBrush}"
                       VerticalAlignment="Center"
                       Margin="48,0,0,0" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="60,12,60,32" Spacing="16">

            <Border x:Name="Card5" CornerRadius="12" Opacity="0"
                    Background="{ThemeResource AppSurfaceOverlayBrush}"
                    BorderBrush="{ThemeResource AppBorderBrush}"
                    BorderThickness="1"
                    Padding="20,18">
                <Border.RenderTransform><TranslateTransform Y="20" /></Border.RenderTransform>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{x:Bind app:App.GetString(\'Setting_PrivacyLock_Title\')}"
                               FontSize="16"
                               Foreground="{ThemeResource AppTextPrimaryBrush}"
                               VerticalAlignment="Center"
                               Margin="4,0,0,0" />
                    <Button Grid.Column="2"
                            Width="160" Height="40"
                            Style="{StaticResource SettingsDropdownButtonStyle}"
                            Background="{ThemeResource AppSurfaceBrush}"
                            Foreground="{ThemeResource AppTextSecondaryBrush}"
                            BorderBrush="{ThemeResource AppBorderBrush}"
                            CornerRadius="10"
                            FontSize="14"
                            VerticalAlignment="Center"
                            Margin="-8,0,0,0"
                            x:Name="PrivacyLockButton"
                            Click="PrivacyLockButton_Click"
                            Visibility="Collapsed">
                        <TextBlock Text="{x:Bind app:App.GetString(\'Setting_PrivacyLock_Setup\')}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Button>
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="12"
                                VerticalAlignment="Center"
                                x:Name="PrivacyLockEnabledPanel"
                                Visibility="Collapsed">
                        <Button MinWidth="160" Height="40"
                                Style="{StaticResource SettingsDropdownButtonStyle}"
                                Background="{ThemeResource AppSurfaceBrush}"
                                Foreground="{ThemeResource AppTextPrimaryBrush}"
                                BorderBrush="{ThemeResource AppBorderBrush}"
                                CornerRadius="10"
                                FontSize="14"
                                x:Name="MigrateFormatEntryButton"
                                Click="MigrateFormatEntryButton_Click"
                                Visibility="Collapsed">
                            <TextBlock Text="{x:Bind app:App.GetString(\'Security_Migrate_Entry\')}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Button>
                        <Button MinWidth="160" Height="40"
                                Style="{StaticResource SettingsDropdownButtonStyle}"
                                Background="{ThemeResource AppSurfaceBrush}"
                                Foreground="{ThemeResource AppTextSecondaryBrush}"
                                BorderBrush="{ThemeResource AppBorderBrush}"
                                CornerRadius="10"
                                FontSize="14"
                                x:Name="WindowsHelloButton" Click="WindowsHelloButton_Click">
                            <TextBlock Text="{x:Bind app:App.GetString('Setting_WinHello_Title')}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Button>
                        <Button MinWidth="160" Height="40"
                                Style="{StaticResource SettingsDropdownButtonStyle}"
                                Background="{ThemeResource AppSurfaceBrush}"
                                Foreground="{ThemeResource AppTextSecondaryBrush}"
                                BorderBrush="{ThemeResource AppBorderBrush}"
                                CornerRadius="10"
                                FontSize="14"
                                x:Name="ChangePasswordButton"
                                Click="ChangePasswordButton_Click">
                            <TextBlock Text="{x:Bind app:App.GetString(\'Setting_PrivacyLock_ChangePassword\')}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Button>
                        <Button MinWidth="160" Height="40"
                                Background="{ThemeResource AppDangerBrush}" Foreground="#FFFFFFFF"
                                CornerRadius="10" FontSize="14" FontWeight="SemiBold"
                                BorderThickness="0"
                                x:Name="DisablePrivacyLockButton"
                                Click="DisablePrivacyLockButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid x:Name="RootGrid" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup x:Name="CommonStates">
                                                <VisualState x:Name="Normal" />
                                                <VisualState x:Name="PointerOver">
                                                    <Storyboard>
                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource AppDangerHoverBrush}" />
                                                        </ObjectAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </VisualState>
                                                <VisualState x:Name="Pressed">
                                                    <Storyboard>
                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource AppDangerPressedBrush}" />
                                                        </ObjectAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </VisualState>
                                                <VisualState x:Name="Disabled" />
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                        <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="{x:Bind app:App.GetString(\'Setting_PrivacyLock_Disable\')}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>


            <Border x:Name="AutoLockCard" CornerRadius="12" Opacity="0"
                    Background="{ThemeResource AppSurfaceOverlayBrush}"
                    BorderBrush="{ThemeResource AppBorderBrush}"
                    BorderThickness="1"
                    Padding="20,18"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="AutoLockTitleText"
                               HorizontalAlignment="Left" VerticalAlignment="Center"
                               FontSize="16" Foreground="{ThemeResource AppTextPrimaryBrush}" Margin="4,0,0,0" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Margin="-8,0,0,0">
                        <Button x:Name="SyncLockButton" Width="160" Height="40"
                                Style="{StaticResource SettingsDropdownButtonStyle}" CornerRadius="10" FontSize="14"
                                VerticalAlignment="Center" Click="SyncLockButton_Click">
                            <TextBlock x:Name="SyncLockButtonText" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                        <Button x:Name="AutoLockButton" Width="160" Height="40"
                                Style="{StaticResource SettingsDropdownButtonStyle}" CornerRadius="10" FontSize="14"
                                VerticalAlignment="Center" Click="AutoLockButton_Click">
                            <TextBlock x:Name="AutoLockButtonText" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </Grid>
                <Border.RenderTransform><TranslateTransform Y="20" /></Border.RenderTransform>
            </Border>


            <Border x:Name="QuickCaptureCard" CornerRadius="12" Opacity="0"
                    Background="{ThemeResource AppSurfaceOverlayBrush}"
                    BorderBrush="{ThemeResource AppBorderBrush}"
                    BorderThickness="1"
                    Padding="20,18">
                <Border.RenderTransform><TranslateTransform Y="20" /></Border.RenderTransform>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="QuickCaptureTitleText" Margin="4,0,0,0"
                               HorizontalAlignment="Left" VerticalAlignment="Center"
                               FontSize="16" Foreground="{ThemeResource AppTextPrimaryBrush}" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Margin="-8,0,0,0">
                        <Button x:Name="QuickCaptureHotkeyButton" Width="160" Height="40"
