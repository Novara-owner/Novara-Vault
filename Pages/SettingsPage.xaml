    <Grid x:Name="SettingsRoot" Background="{ThemeResource AppSurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="Transparent" Margin="24,20,24,12">
            <Button x:Name="BackButton"
                    Click="BackButton_Click"
                    Width="36" Height="36"
                    Style="{StaticResource NovaraPrimaryButtonStyle}"
                    CornerRadius="8"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center">
                <Path x:Name="BackPathIcon"
                      Width="18" Height="18"
                      Stretch="Uniform"
                      Fill="#FFFFFFFF" />
            </Button>
            <TextBlock x:Name="SettingsTitleText"
                       FontSize="20" FontWeight="SemiBold"
                       Foreground="{ThemeResource AppTextPrimaryBrush}"
                       VerticalAlignment="Center"
                       Margin="48,0,0,0" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="60,32,60,32" Spacing="16">

            
            <Border x:Name="StatsCard" CornerRadius="12"
                    Background="{ThemeResource AppSurfaceOverlayBrush}"
                    BorderBrush="{ThemeResource AppBorderBrush}"
                    BorderThickness="1"
                    Padding="20,18"
                    Opacity="0">
                <Border.RenderTransform><TranslateTransform Y="20" /></Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   x:Name="StatsTitleText"
                                   FontSize="16"
                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="4,0,0,0" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Margin="-8,0,0,0">
                            <Button x:Name="StatsExpandButton"
                                    Width="40" Height="40"
                                    Style="{StaticResource NovaraIconButtonStyle}"
                                    CornerRadius="10"
                                    VerticalAlignment="Center"
                                    Click="StatsExpandButton_Click"
                                    Visibility="Collapsed">
                                <Viewbox Width="18" Height="18" Stretch="Uniform">
                                    <PathIcon x:Name="StatsExpandIcon" Foreground="{ThemeResource IconForegroundBrush}" />
                                </Viewbox>
                            </Button>
                            <Button x:Name="StatsToggleButton"
                                    Width="160" Height="40"
                                    Style="{StaticResource SettingsDropdownButtonStyle}"
                                    Background="{ThemeResource AppSurfaceBrush}"
                                    Foreground="{ThemeResource AppTextSecondaryBrush}"
                                    BorderBrush="{ThemeResource AppBorderBrush}"
                                    CornerRadius="10"
                                    FontSize="14"
                                    VerticalAlignment="Center"
                                    Click="StatsToggleButton_Click">
                                <TextBlock Text="{x:Bind app:App.GetString(\'Setting_Stats_Off\')}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="StatsDetailPanel" Grid.Row="1" Visibility="Collapsed" Margin="0,16,0,0">
                        <Grid x:Name="StatsGrid" />
                    </Grid>
                </Grid>
            </Border>

            <Border x:Name="McpCard" CornerRadius="12" Opacity="0"
                    Background="{ThemeResource AppSurfaceOverlayBrush}"
                    BorderBrush="{ThemeResource AppBorderBrush}"
                    BorderThickness="1"
                    Padding="20,18">
                <Border.RenderTransform><TranslateTransform Y="20" /></Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   x:Name="McpTitleText"
                                   FontSize="16"
                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="4,0,0,0" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Margin="-8,0,0,0">
                            <Button x:Name="McpExpandButton"
                                    Width="40" Height="40"
                                    Style="{StaticResource NovaraIconButtonStyle}"
                                    CornerRadius="10"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed"
                                    Click="McpExpandButton_Click">
                                <Viewbox Width="18" Height="18" Stretch="Uniform">
                                    <PathIcon x:Name="McpExpandIcon" Foreground="{ThemeResource IconForegroundBrush}" />
                                </Viewbox>
                            </Button>
                            <Button x:Name="McpAuditButton"
                                    Width="160" Height="40"
                                    Style="{StaticResource SettingsDropdownButtonStyle}"
                                    Background="{ThemeResource AppSurfaceBrush}"
                                    Foreground="{ThemeResource AppTextPrimaryBrush}"
                                    BorderBrush="{ThemeResource AppBorderBrush}"
                                    CornerRadius="10"
                                    FontSize="14"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed"
                                    Click="McpAuditButton_Click">
                                <TextBlock x:Name="McpAuditButtonText" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                            <Button x:Name="McpConfigButton"
                                    Width="160" Height="40"
                                    Style="{StaticResource SettingsDropdownButtonStyle}"
                                    Background="{ThemeResource AppSurfaceBrush}"
                                    Foreground="{ThemeResource AppTextPrimaryBrush}"
                                    BorderBrush="{ThemeResource AppBorderBrush}"
                                    CornerRadius="10"
                                    FontSize="14"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed"
                                    Click="McpConfigButton_Click">
                                <TextBlock x:Name="McpConfigButtonText" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                            <Button x:Name="McpToggleButton"
                                    Width="160" Height="40"
                                    Style="{StaticResource SettingsDropdownButtonStyle}"
                                    Background="{ThemeResource AppSurfaceBrush}"
                                    Foreground="{ThemeResource AppTextSecondaryBrush}"
                                    BorderBrush="{ThemeResource AppBorderBrush}"
                                    CornerRadius="10"
                                    FontSize="14"
                                    VerticalAlignment="Center"
                                    Click="McpToggleButton_Click">
                                <TextBlock x:Name="McpToggleText" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" x:Name="McpDetailPanel" Visibility="Collapsed" Margin="0,16,0,0">
                        <Grid x:Name="McpAuthorizedListHost" MinHeight="120">
                            <StackPanel x:Name="McpAuthorizedList" />
                            <TextBlock x:Name="McpNoAuthorizedText" FontSize="12" Foreground="{ThemeResource AppTextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="Card1" CornerRadius="12"
                    Background="{ThemeResource AppSurfaceOverlayBrush}"
                    BorderBrush="{ThemeResource AppBorderBrush}"
                    BorderThickness="1"
                    Padding="20,18"
                    Opacity="0">
                <Border.RenderTransform><TranslateTransform Y="20" /></Border.RenderTransform>
                <Grid>
                    <Grid.ColumnDefinitions>
