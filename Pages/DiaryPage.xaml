<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Novara.Pages.DiaryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:app="using:Novara"
    xmlns:local="using:Novara.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
    </Page.Resources>

    <Grid x:Name="RootGrid" ContextRequested="RootGrid_ContextRequested">

        <TextBlock x:Name="EmptyHint"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextAlignment="Center"
                   FontSize="13"
                   FontWeight="Light"
                   Foreground="{ThemeResource AppTextTertiaryBrush}"
                   Opacity="0.6"
                   TextWrapping="NoWrap"
                   MaxWidth="600"
                   Visibility="Visible" />

        <ScrollViewer x:Name="DiaryScrollViewer"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      ContextRequested="RootGrid_ContextRequested">
            <StackPanel x:Name="DiaryList"
                        Padding="40,12,40,20"
                        Spacing="12">

            </StackPanel>
        </ScrollViewer>

        
        <Canvas x:Name="DragLayer" IsHitTestVisible="False" />

        <Grid x:Name="DeleteConfirmOverlay"
              Visibility="Collapsed"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
            <Grid x:Name="DeleteConfirmScrim"
                  Background="#2E000000"
                  Tapped="DeleteConfirmScrim_Tapped" />
            <Border x:Name="DeleteConfirmDialog"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="400"
                    CornerRadius="24"
                    Background="{ThemeResource AppDialogBgBrush}"
                    BorderBrush="{ThemeResource AppDialogBorderBrush}"
                    BorderThickness="1"
                    Opacity="0">
                <Border.RenderTransform>
                    <CompositeTransform x:Name="DeleteConfirmDialogTransform"
                                        ScaleX="0.92" ScaleY="0.92" TranslateY="20" />
                </Border.RenderTransform>
                <Grid Padding="28,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBlock Text="{x:Bind app:App.GetString(\'Dialog_Delete_Title\')}"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource AppPrimaryButtonBrush}" />
                        <Button HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Width="28" Height="28"
                                Style="{StaticResource NovaraIconButtonStyle}"
                                Click="DeleteConfirmCloseButton_Click">
                            <Path Data="M278.528 278.528L745.472 745.472M745.472 278.528L278.528 745.472"
                                  Stroke="{ThemeResource IconForegroundBrush}"
                                  StrokeThickness="1.8"
                                  Stretch="Uniform"
                                  Width="16" Height="16" />
                        </Button>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="0,20,0,0"><TextBlock Grid.Row="1"
                               Text="{x:Bind app:App.GetString(\'Diary_Delete_ConfirmTip\')}"
                               FontSize="14"
                               Foreground="{ThemeResource AppTextPrimaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0" /></StackPanel>

                    <Grid Grid.Row="2" Margin="0,20,0,0">
                        <Button HorizontalAlignment="Left"
                                Width="160" Height="36"
                                Style="{StaticResource NovaraOutlineButtonStyle}"
                                CornerRadius="10"
                                FontSize="14"
                                Click="DeleteCancelButton_Click">
                            <TextBlock Text="{x:Bind app:App.GetString(\'Common_Button_Cancel\')}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center" />
                        </Button>

                        <Button HorizontalAlignment="Right" Width="160" Height="36" Style="{StaticResource NovaraPrimaryButtonStyle}" CornerRadius="10" FontSize="14" Click="DeleteConfirmButton_Click"><TextBlock Text="{x:Bind app:App.GetString(\'Common_Button_Delete\')}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <!-- FocusSink: steals focus (no focus border on an invisible 0x0 button), LockScreenPage/SearchPage fix -->
        <Button x:Name="FocusSink" Width="0" Height="0" Opacity="0" IsTabStop="True" />
    </Grid>
</Page>
