<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Novara.Pages.PlanPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:app="using:Novara"
    xmlns:local="using:Novara.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="{ThemeResource AppSurfaceBrush}" ContextRequested="RootGrid_ContextRequested" IsTabStop="False">
        <ScrollViewer x:Name="CardScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="CardList" Padding="40,12,40,20" Spacing="12" />
        </ScrollViewer>

        
        <Canvas x:Name="DragLayer" IsHitTestVisible="False" />

        <TextBlock x:Name="EmptyHint"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextAlignment="Center"
                   FontSize="13" FontWeight="Light"
                   Foreground="{ThemeResource AppTextTertiaryBrush}"
                   Opacity="0.6" TextWrapping="NoWrap" MaxWidth="600"
                   Visibility="Visible" />

        <Grid x:Name="ReminderOverlay" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid x:Name="ReminderScrim" Background="#2E000000" Tapped="ReminderScrim_Tapped" />
            <Border x:Name="ReminderDialog" HorizontalAlignment="Center" VerticalAlignment="Center" Width="460" CornerRadius="24" Background="{ThemeResource AppDialogBgBrush}" BorderBrush="{ThemeResource AppDialogBorderBrush}" BorderThickness="1" Opacity="0">
                <Border.RenderTransform>
                    <CompositeTransform x:Name="ReminderDialogTransform" ScaleX="0.92" ScaleY="0.92" TranslateY="20" />
                </Border.RenderTransform>
                <Grid Padding="28,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <TextBlock x:Name="ReminderDialogTitle" Text="{x:Bind app:App.GetString(\'Reminder_New_Title\')}" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource AppPrimaryButtonBrush}" />
                        <Button HorizontalAlignment="Right" VerticalAlignment="Center" Width="28" Height="28" Style="{StaticResource NovaraIconButtonStyle}" Click="CloseReminderDialog_Click">
                            <Path Data="M278.528 278.528L745.472 745.472M745.472 278.528L278.528 745.472" Stroke="{ThemeResource IconForegroundBrush}" StrokeThickness="1.8" Stretch="Uniform" Width="16" Height="16" />
                        </Button>
                    </Grid>
                    <TextBox x:Name="ReminderContentBox" Grid.Row="1" Margin="0" Height="80" MaxLength="240" AcceptsReturn="True" TextWrapping="Wrap" TextChanged="PlanField_TextChanged"
                             Style="{StaticResource NovaraTextBoxStyle}"
                             PlaceholderText="{x:Bind app:App.GetString(\'Reminder_ContentPlaceholder\')}" />
                    <StackPanel Grid.Row="2" Spacing="14" Margin="0,8,0,0">
                        <TextBlock Text="{x:Bind app:App.GetString(\'Reminder_TimeLabel\')}" FontSize="12" FontWeight="Medium" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                        <DatePicker x:Name="ReminderDatePicker" />
                        <TimePicker x:Name="ReminderTimePicker" />
                    </StackPanel>
                    <Grid Grid.Row="3" Margin="0">
                        
                        <Button x:Name="ConfirmReminderDialogButton" HorizontalAlignment="Center" Width="220" Height="40" Style="{StaticResource NovaraPrimaryButtonStyle}" CornerRadius="10" FontSize="14" Click="ConfirmReminderDialog_Click">
                            <TextBlock Text="{x:Bind app:App.GetString(\'Common_Button_Confirm\')}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="NewTodoOverlay" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid x:Name="NewTodoScrim" Background="#2E000000" Tapped="NewTodoScrim_Tapped" />
            <Border x:Name="NewTodoDialog" HorizontalAlignment="Center" VerticalAlignment="Center" Width="520" CornerRadius="24" Background="{ThemeResource AppDialogBgBrush}" BorderBrush="{ThemeResource AppDialogBorderBrush}" BorderThickness="1" Opacity="0">
                <Border.RenderTransform>
                    <CompositeTransform x:Name="NewTodoDialogTransform" ScaleX="0.92" ScaleY="0.92" TranslateY="20" />
                </Border.RenderTransform>
                <Grid Padding="28,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBlock x:Name="NewTodoDialogTitle" Text="{x:Bind app:App.GetString(\'Plan_Todo_NewTitle\')}" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource AppPrimaryButtonBrush}" />
                        <Button HorizontalAlignment="Right" VerticalAlignment="Center" Width="28" Height="28" Style="{StaticResource NovaraIconButtonStyle}" Click="CloseNewTodo_Click">
                            <Path Data="M278.528 278.528L745.472 745.472M745.472 278.528L278.528 745.472" Stroke="{ThemeResource IconForegroundBrush}" StrokeThickness="1.8" Stretch="Uniform" Width="16" Height="16" />
                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalScrollMode="Enabled" HorizontalScrollMode="Disabled" Margin="0">
                        <StackPanel Spacing="16">

                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="{x:Bind app:App.GetString(\'Common_Label_PickIcon\')}" FontSize="12" FontWeight="Medium" Foreground="{ThemeResource AppTextSecondaryBrush}" Margin="0,0,0,8" />
                                <ScrollViewer Grid.Row="1" x:Name="IconScrollViewer" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled" ZoomMode="Disabled" Height="56" Background="Transparent">
                                    <StackPanel x:Name="IconPanel" Orientation="Horizontal" Spacing="8" />
                                </ScrollViewer>
                            </Grid>

                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="{x:Bind app:App.GetString(\'Common_Label_Name\')}" FontSize="12" FontWeight="Medium" Foreground="{ThemeResource AppTextSecondaryBrush}" Margin="0,0,0,8" />
                                <TextBox x:Name="TodoNameBox" Grid.Row="1" Style="{StaticResource NovaraTextBoxStyle}" MaxLength="50" PlaceholderText="{x:Bind app:App.GetString(\'Plan_Todo_NamePlaceholder\')}" TextChanged="PlanField_TextChanged" />
                            </Grid>

                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="{x:Bind app:App.GetString(\'Plan_Todo_MainLabel\')}" FontSize="12" FontWeight="Medium" Foreground="{ThemeResource AppTextSecondaryBrush}" Margin="0,0,0,8" />
                                <TextBox Grid.Row="1" x:Name="MainTodoBox" Style="{StaticResource NovaraTextBoxStyle}" MaxLength="500" PlaceholderText="{x:Bind app:App.GetString(\'Plan_Todo_MainPlaceholder\')}" TextChanged="PlanField_TextChanged" />
                            </Grid>

                            <StackPanel x:Name="SubTodoPanel" Spacing="10" />

                            <Button x:Name="AddSubTodoButton" Height="40" HorizontalAlignment="Stretch" Style="{StaticResource NovaraIconButtonStyle}" Background="Transparent" Foreground="{ThemeResource AppTextTertiaryBrush}" BorderThickness="0" CornerRadius="12" FontSize="13" FontWeight="Normal" Click="AddSubTodoButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Viewbox Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Opacity="0.6" Margin="0,1,0,0">
                                        <PathIcon Data="M278.9376 552.5504h192.512v192.512c0 5.597867 4.573867 10.171733 10.171733 10.171733h60.757334a10.171733 10.171733 0 0 0 10.171733-10.171733v-192.512h192.512a10.171733 10.171733 0 0 0 10.171733-10.171733v-60.757334a10.171733 10.171733 0 0 0-10.171733-10.171733h-192.512v-192.512a10.171733 10.171733 0 0 0-10.171733-10.171733h-60.757334a10.171733 10.171733 0 0 0-10.171733 10.171733v192.512h-192.512a10.171733 10.171733 0 0 0-10.171733 10.171733v60.757334c0 5.597867 4.573867 10.171733 10.171733 10.171733z M978.1248 5.3248H45.8752a40.482133 40.482133 0 0 0-40.5504 40.5504v932.2496c0 22.459733 18.090667 40.5504 40.5504 40.5504h932.2496a40.482133 40.482133 0 0 0 40.5504-40.5504V45.8752a40.482133 40.482133 0 0 0-40.5504-40.5504z m-50.653867 922.146133H96.529067V96.529067h830.941866v830.941866z" Foreground="{ThemeResource IconForegroundBrush}" />
                                    </Viewbox>
                                    <TextBlock Text="{x:Bind app:App.GetString(\'Plan_Todo_AddSubButton\')}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                        </StackPanel>
                    </ScrollViewer>

                    
                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Button HorizontalAlignment="Center" Width="220" Height="40" x:Name="NewTodoConfirmButton" Style="{StaticResource NovaraPrimaryButtonStyle}" CornerRadius="12" FontSize="14" Click="NewTodoConfirm_Click">
                            <TextBlock Text="{x:Bind app:App.GetString(\'Common_Button_Confirm\')}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="NewNoteOverlay" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid x:Name="NewNoteScrim" Background="#2E000000" Tapped="NewNoteScrim_Tapped" />
            <Border x:Name="NewNoteDialog" Width="600" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="24" Background="{ThemeResource AppDialogBgBrush}" BorderBrush="{ThemeResource AppDialogBorderBrush}" BorderThickness="1" Opacity="0">
                <Border.RenderTransform>
                    <CompositeTransform x:Name="NewNoteDialogTransform" ScaleX="0.92" ScaleY="0.92" TranslateY="20" />
                </Border.RenderTransform>
                <Grid Padding="28,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <TextBlock x:Name="NewNoteDialogTitle" Text="{x:Bind app:App.GetString(\'Plan_Note_NewTitle\')}" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource AppPrimaryButtonBrush}" />
                        <Button HorizontalAlignment="Right" VerticalAlignment="Center" Width="28" Height="28" Style="{StaticResource NovaraIconButtonStyle}" Click="CloseNewNote_Click">
                            <Path Data="M278.528 278.528L745.472 745.472M745.472 278.528L278.528 745.472" Stroke="{ThemeResource IconForegroundBrush}" StrokeThickness="1.8" Stretch="Uniform" Width="16" Height="16" />
                        </Button>
                    </Grid>
                    <!-- 6.1-X-08: whole content area scrolls as one page (same as the todo dialog);
                         title + confirm stay fixed; icon/name/content blocks scroll together -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalScrollMode="Enabled" HorizontalScrollMode="Disabled" Margin="0,16,0,0">
                        <StackPanel Spacing="16">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="{x:Bind app:App.GetString(\'Common_Label_PickIcon\')}" FontSize="12" FontWeight="Medium" Foreground="{ThemeResource AppTextSecondaryBrush}" Margin="0,0,0,8" />
                                <ScrollViewer Grid.Row="1" x:Name="NoteIconScrollViewer" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled" ZoomMode="Disabled" Height="56" Background="Transparent">
                                    <StackPanel x:Name="NoteIconPanel" Orientation="Horizontal" Spacing="8" />
                                </ScrollViewer>
                            </Grid>
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="{x:Bind app:App.GetString(\'Common_Label_Name\')}" FontSize="12" FontWeight="Medium" Foreground="{ThemeResource AppTextSecondaryBrush}" Margin="0,0,0,8" />
                                <TextBox x:Name="NoteNameBox" Grid.Row="1" Style="{StaticResource NovaraTextBoxStyle}" MaxLength="50" PlaceholderText="{x:Bind app:App.GetString(\'Plan_Note_NamePlaceholder\')}" TextChanged="PlanField_TextChanged" />
                            </Grid>
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="{x:Bind app:App.GetString(\'Common_Label_Content\')}" FontSize="12" FontWeight="Medium" Foreground="{ThemeResource AppTextSecondaryBrush}" Margin="0,0,0,8" />
                                <TextBox Grid.Row="1" x:Name="NoteContentBox" Style="{StaticResource NovaraTextBoxStyle}" PlaceholderText="{x:Bind app:App.GetString(\'Plan_Note_ContentPlaceholder\')}" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="10000" IsSpellCheckEnabled="False" TextChanged="PlanField_TextChanged" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    
                    <Grid Grid.Row="2" Margin="0,16,0,0">
                        <Button HorizontalAlignment="Center" Width="220" Height="40" x:Name="NewNoteConfirmButton" Style="{StaticResource NovaraPrimaryButtonStyle}" CornerRadius="12" FontSize="14" Click="NewNoteConfirm_Click">
                            <TextBlock Text="{x:Bind app:App.GetString(\'Common_Button_Confirm\')}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="DeleteConfirmOverlay" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid x:Name="DeleteConfirmScrim" Background="#2E000000" Tapped="DeleteConfirmScrim_Tapped" />
            <Border x:Name="DeleteConfirmDialog" HorizontalAlignment="Center" VerticalAlignment="Center" Width="400" CornerRadius="24" Background="{ThemeResource AppDialogBgBrush}" BorderBrush="{ThemeResource AppDialogBorderBrush}" BorderThickness="1" Opacity="0">
                <Border.RenderTransform><CompositeTransform x:Name="DeleteConfirmDialogTransform" ScaleX="0.92" ScaleY="0.92" TranslateY="20" /></Border.RenderTransform>
                <Grid Padding="28,24">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0"><TextBlock x:Name="DeleteConfirmTitleText" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource AppPrimaryButtonBrush}" /><Button HorizontalAlignment="Right" VerticalAlignment="Center" Width="28" Height="28" Style="{StaticResource NovaraIconButtonStyle}" Click="DeleteConfirmClose_Click"><Path Data="M278.528 278.528L745.472 745.472M745.472 278.528L278.528 745.472" Stroke="{ThemeResource IconForegroundBrush}" StrokeThickness="1.8" Stretch="Uniform" Width="16" Height="16" /></Button></Grid>
                    <StackPanel Grid.Row="1" Margin="0,20,0,0"><TextBlock x:Name="DeleteConfirmMessageText" FontSize="14" Foreground="{ThemeResource AppTextPrimaryBrush}" TextWrapping="Wrap" Margin="0" /></StackPanel>
                    <Grid Grid.Row="2" Margin="0,20,0,0">
                        <Button HorizontalAlignment="Left" Width="160" Height="36" Style="{StaticResource NovaraOutlineButtonStyle}" CornerRadius="10" FontSize="14" Click="DeleteConfirmClose_Click"><TextBlock x:Name="DeleteCancelText" HorizontalAlignment="Center" VerticalAlignment="Center" /></Button>
                        <Button HorizontalAlignment="Right" Width="160" Height="36" Style="{StaticResource NovaraPrimaryButtonStyle}" CornerRadius="10" FontSize="14" Click="DeleteConfirmButton_Click"><TextBlock x:Name="DeleteConfirmText" HorizontalAlignment="Center" VerticalAlignment="Center" /></Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        
        <Grid x:Name="SetReminderOverlay" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid x:Name="SetReminderScrim" Background="#2E000000" Tapped="SetReminderScrim_Tapped" />
            <Border x:Name="SetReminderDialog" HorizontalAlignment="Center" VerticalAlignment="Center" Width="460" CornerRadius="24" Background="{ThemeResource AppDialogBgBrush}" BorderBrush="{ThemeResource AppDialogBorderBrush}" BorderThickness="1" Opacity="0">
                <Border.RenderTransform><CompositeTransform x:Name="SetReminderDialogTransform" ScaleX="0.92" ScaleY="0.92" TranslateY="20" /></Border.RenderTransform>
                <Grid Padding="28,24">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0"><TextBlock x:Name="SetReminderTitleText" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource AppPrimaryButtonBrush}" /><Button HorizontalAlignment="Right" VerticalAlignment="Center" Width="28" Height="28" Style="{StaticResource NovaraIconButtonStyle}" Click="SetReminderClose_Click"><Path Data="M278.528 278.528L745.472 745.472M745.472 278.528L278.528 745.472" Stroke="{ThemeResource IconForegroundBrush}" StrokeThickness="1.8" Stretch="Uniform" Width="16" Height="16" /></Button></Grid>
                    <StackPanel Grid.Row="1" Spacing="14" Margin="0,8,0,0"><DatePicker x:Name="SetReminderDatePicker" /><TimePicker x:Name="SetReminderTimePicker" /></StackPanel>
                    <Grid Grid.Row="2" Margin="0"><Button x:Name="SetReminderConfirmButton" HorizontalAlignment="Center" Width="220" Height="40" Style="{StaticResource NovaraPrimaryButtonStyle}" CornerRadius="10" FontSize="14" Click="SetReminderConfirm_Click"><TextBlock Text="{x:Bind app:App.GetString(\'Common_Button_Confirm\')}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Button></Grid>
                </Grid>
            </Border>
        </Grid>

        
        <Grid x:Name="CancelReminderOverlay" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid x:Name="CancelReminderScrim" Background="#2E000000" Tapped="CancelReminderScrim_Tapped" />
            <Border x:Name="CancelReminderDialog" HorizontalAlignment="Center" VerticalAlignment="Center" Width="400" CornerRadius="24" Background="{ThemeResource AppDialogBgBrush}" BorderBrush="{ThemeResource AppDialogBorderBrush}" BorderThickness="1" Opacity="0">
                <Border.RenderTransform><CompositeTransform x:Name="CancelReminderDialogTransform" ScaleX="0.92" ScaleY="0.92" TranslateY="20" /></Border.RenderTransform>
                <Grid Padding="28,24">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0"><TextBlock x:Name="CancelReminderTitleText" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource AppPrimaryButtonBrush}" /><Button HorizontalAlignment="Right" VerticalAlignment="Center" Width="28" Height="28" Style="{StaticResource NovaraIconButtonStyle}" Click="CancelReminderClose_Click"><Path Data="M278.528 278.528L745.472 745.472M745.472 278.528L278.528 745.472" Stroke="{ThemeResource IconForegroundBrush}" StrokeThickness="1.8" Stretch="Uniform" Width="16" Height="16" /></Button></Grid>
                    <TextBlock x:Name="CancelReminderMessageText" Grid.Row="1" FontSize="14" Foreground="{ThemeResource AppTextPrimaryBrush}" TextWrapping="Wrap" Margin="0,16,0,0" />
                    <Grid Grid.Row="2" Margin="0,20,0,0"><Button HorizontalAlignment="Center" Width="220" Height="40" Style="{StaticResource NovaraPrimaryButtonStyle}" CornerRadius="10" FontSize="14" Click="CancelReminderConfirm_Click"><TextBlock Text="{x:Bind app:App.GetString(\'Common_Button_Confirm\')}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Button></Grid>
                </Grid>
            </Border>
        </Grid>

        
        <Grid x:Name="ReminderDueOverlay" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid x:Name="ReminderDueScrim" Background="#2E000000" Tapped="ReminderDueScrim_Tapped" />
            <Border x:Name="ReminderDueDialog" HorizontalAlignment="Center" VerticalAlignment="Center" Width="420" CornerRadius="24" Background="{ThemeResource AppDialogBgBrush}" BorderBrush="{ThemeResource AppDialogBorderBrush}" BorderThickness="1" Opacity="0">
                <Border.RenderTransform><CompositeTransform x:Name="ReminderDueDialogTransform" ScaleX="0.92" ScaleY="0.92" TranslateY="20" /></Border.RenderTransform>
                <Grid Padding="28,24">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0"><TextBlock x:Name="ReminderDueTitleText" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource AppPrimaryButtonBrush}" /><Button HorizontalAlignment="Right" VerticalAlignment="Center" Width="28" Height="28" Style="{StaticResource NovaraIconButtonStyle}" Click="ReminderDueClose_Click"><Path Data="M278.528 278.528L745.472 745.472M745.472 278.528L278.528 745.472" Stroke="{ThemeResource IconForegroundBrush}" StrokeThickness="1.8" Stretch="Uniform" Width="16" Height="16" /></Button></Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,4,0,8"><TextBlock x:Name="ReminderDueContentText" FontSize="14" Foreground="{ThemeResource AppTextPrimaryBrush}" TextWrapping="Wrap" /></ScrollViewer>
                    <Grid Grid.Row="2" Margin="0"><Button HorizontalAlignment="Center" Width="160" Height="36" Style="{StaticResource NovaraPrimaryButtonStyle}" CornerRadius="10" FontSize="14" Click="ReminderDueConfirm_Click"><TextBlock x:Name="ReminderDueConfirmText" HorizontalAlignment="Center" VerticalAlignment="Center" /></Button></Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- FocusSink: steals focus (no focus border on an invisible 0x0 button), LockScreenPage/SearchPage fix -->
        <Button x:Name="FocusSink" Width="0" Height="0" Opacity="0" IsTabStop="True" />
    </Grid>
</Page>
