<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Novara.Pages.TrashPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:app="using:Novara"
    xmlns:services="using:Novara.Services"
    mc:Ignorable="d"
    Background="{ThemeResource AppSurfaceBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top bar: back button + title -->
        <Grid Grid.Row="0" Margin="24,20,24,12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton"
                    Width="36" Height="36"
                    Style="{StaticResource NovaraPrimaryButtonStyle}"
                    CornerRadius="8"
                    Click="BackButton_Click"
                    VerticalAlignment="Center">
                <Path x:Name="BackPathIcon" Width="18" Height="18" Stretch="Uniform"
                      Fill="#FFFFFFFF" />
            </Button>
            <TextBlock Grid.Column="1"
                       Text="{x:Bind app:App.GetString(\'Trash_Title\')}"
                       FontSize="20" FontWeight="SemiBold"
                       Foreground="{ThemeResource AppTextPrimaryBrush}"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0" />
        </Grid>

        <!-- List -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="24,8,24,88">
            <StackPanel x:Name="TrashList" Spacing="10" />
        </ScrollViewer>

        <!-- Bottom-right floating action rail: restore-all + clear-all -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Spacing="12"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,24,24">
            <!-- Restore-all (brand blue, non-danger) -->
            <Button x:Name="RestoreAllButton"
                    MinWidth="132" Height="40" Padding="14,0"
                    Style="{StaticResource NovaraPrimaryButtonStyle}"
                    CornerRadius="10" FontSize="13" FontWeight="SemiBold"
                    Click="RestoreAllButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Path x:Name="RestoreAllPathIcon" Width="16" Height="16" Stretch="Uniform" Fill="#FFFFFFFF" />
                    <TextBlock Text="{x:Bind app:App.GetString(\'Trash_RestoreAll\')}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <!-- Clear-all: danger (separated from the safe restore-all) -->
            <Button x:Name="ClearAllButton"
                    MinWidth="132" Height="40" Padding="14,0"
                    Background="#CCFF4545" Foreground="#FFFFFFFF"
                    CornerRadius="10" FontSize="13" FontWeight="SemiBold" BorderThickness="0"
                    Click="ClearAllButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="RootGrid" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#FFFF4545" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#CC3A3A" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Path x:Name="ClearAllPathIcon" Width="16" Height="16" Stretch="Uniform" Fill="#FFFFFFFF" />
                    <TextBlock Text="{x:Bind app:App.GetString(\'Trash_ClearAll\')}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Empty state (text only) -->
        <StackPanel x:Name="EmptyState" Grid.Row="1" Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"
                    Margin="0,-12,0,0">
            <TextBlock Text="{x:Bind app:App.GetString(\'Trash_EmptyHint\')}"
                       HorizontalAlignment="Center" TextAlignment="Center"
                       FontSize="13" FontWeight="Light"
                       Foreground="{ThemeResource AppTextTertiaryBrush}"
                       Opacity="0.6" />
        </StackPanel>

        <!-- Delete-forever confirm dialog (red) -->
        <Grid x:Name="DeleteForeverOverlay" Visibility="Collapsed" Grid.RowSpan="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid x:Name="DeleteForeverScrim" Background="#2E000000" Tapped="DeleteForeverScrim_Tapped" />
            <Border x:Name="DeleteForeverDialog" HorizontalAlignment="Center" VerticalAlignment="Center" Width="420" CornerRadius="24" Background="{ThemeResource AppDialogBgBrush}" BorderBrush="{ThemeResource AppDialogBorderBrush}" BorderThickness="1" Opacity="0">
                <Border.RenderTransform>
                    <CompositeTransform x:Name="DeleteForeverDialogTransform" ScaleX="0.92" ScaleY="0.92" TranslateY="20" />
                </Border.RenderTransform>
                <Grid Padding="28,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <Viewbox Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0">
                                <PathIcon x:Name="DeleteForeverDangerIcon" Foreground="#FF4545" />
                            </Viewbox>
                            <TextBlock Text="{x:Bind app:App.GetString(\'Trash_DeleteForever\')}" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Foreground="#FFFF4545" />
                        </StackPanel>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Center" Width="28" Height="28" Style="{StaticResource NovaraIconButtonStyle}" Click="DeleteForeverClose_Click">
                            <Path Data="M278.528 278.528L745.472 745.472M745.472 278.528L278.528 745.472" Stroke="{ThemeResource IconForegroundBrush}" StrokeThickness="1.8" Stretch="Uniform" Width="16" Height="16" />
                        </Button>
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{x:Bind app:App.GetString(\'Trash_DeleteForever_ConfirmTip\')}" FontSize="14" Foreground="#FFFF4545" TextWrapping="Wrap" Margin="0,20,0,0" />
                    <Grid Grid.Row="2" Margin="0,20,0,0">
                        <Button HorizontalAlignment="Left" Width="160" Height="36" Style="{StaticResource NovaraOutlineButtonStyle}" CornerRadius="10" FontSize="14" Click="DeleteForeverCancel_Click">
                            <TextBlock Text="{x:Bind app:App.GetString(\'Common_Button_Cancel\')}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                        <services:CountdownBorder x:Name="DeleteForeverCd" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button HorizontalAlignment="Center" Width="160" Height="36" Background="#CCFF4545" Foreground="#FFFFFFFF" CornerRadius="10" FontSize="14" FontWeight="SemiBold" BorderThickness="0" x:Name="DeleteForeverConfirmButton" Click="DeleteForeverConfirm_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid x:Name="RootGrid" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup x:Name="CommonStates">
                                                <VisualState x:Name="Normal" />
                                                <VisualState x:Name="PointerOver">
                                                    <Storyboard>
                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#FFFF4545" />
                                                        </ObjectAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </VisualState>
                                                <VisualState x:Name="Pressed">
                                                    <Storyboard>
                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#CC3A3A" />
                                                        </ObjectAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </VisualState>
                                                <VisualState x:Name="Disabled" />
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                        <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                    </Grid>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="{x:Bind app:App.GetString(\'Trash_DeleteForever\')}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                        </services:CountdownBorder>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Clear-all confirm dialog (red) -->
        <Grid x:Name="ClearAllOverlay" Visibility="Collapsed" Grid.RowSpan="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid x:Name="ClearAllScrim" Background="#2E000000" Tapped="ClearAllScrim_Tapped" />
            <Border x:Name="ClearAllDialog" HorizontalAlignment="Center" VerticalAlignment="Center" Width="420" CornerRadius="24" Background="{ThemeResource AppDialogBgBrush}" BorderBrush="{ThemeResource AppDialogBorderBrush}" BorderThickness="1" Opacity="0">
                <Border.RenderTransform>
                    <CompositeTransform x:Name="ClearAllDialogTransform" ScaleX="0.92" ScaleY="0.92" TranslateY="20" />
                </Border.RenderTransform>
                <Grid Padding="28,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <Viewbox Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0">
                                <PathIcon x:Name="ClearAllDangerIcon" Foreground="#FF4545" />
                            </Viewbox>
                            <TextBlock Text="{x:Bind app:App.GetString(\'Trash_ClearAll_ConfirmTitle\')}" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Foreground="#FFFF4545" />
                        </StackPanel>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Center" Width="28" Height="28" Style="{StaticResource NovaraIconButtonStyle}" Click="ClearAllClose_Click">
                            <Path Data="M278.528 278.528L745.472 745.472M745.472 278.528L278.528 745.472" Stroke="{ThemeResource IconForegroundBrush}" StrokeThickness="1.8" Stretch="Uniform" Width="16" Height="16" />
                        </Button>
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{x:Bind app:App.GetString(\'Trash_ClearAll_ConfirmTip\')}" FontSize="14" Foreground="#FFFF4545" TextWrapping="Wrap" Margin="0,20,0,0" />
                    <Grid Grid.Row="2" Margin="0,20,0,0">
                        <Button HorizontalAlignment="Left" Width="160" Height="36" Style="{StaticResource NovaraOutlineButtonStyle}" CornerRadius="10" FontSize="14" Click="ClearAllCancel_Click">
                            <TextBlock Text="{x:Bind app:App.GetString(\'Common_Button_Cancel\')}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                        <services:CountdownBorder x:Name="ClearAllCd" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button HorizontalAlignment="Center" Width="160" Height="36" Background="#CCFF4545" Foreground="#FFFFFFFF" CornerRadius="10" FontSize="14" FontWeight="SemiBold" BorderThickness="0" x:Name="ClearAllConfirmButton" Click="ClearAllConfirm_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid x:Name="RootGrid" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup x:Name="CommonStates">
                                                <VisualState x:Name="Normal" />
                                                <VisualState x:Name="PointerOver">
                                                    <Storyboard>
                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#FFFF4545" />
                                                        </ObjectAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </VisualState>
                                                <VisualState x:Name="Pressed">
                                                    <Storyboard>
                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#CC3A3A" />
                                                        </ObjectAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </VisualState>
                                                <VisualState x:Name="Disabled" />
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                        <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                    </Grid>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="{x:Bind app:App.GetString(\'Trash_ClearAll\')}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                        </services:CountdownBorder>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <!-- FocusSink: steals focus (no focus border on an invisible 0x0 button), LockScreenPage/SearchPage fix -->
        <Button x:Name="FocusSink" Width="0" Height="0" Opacity="0" IsTabStop="True" />
    </Grid>
</Page>
