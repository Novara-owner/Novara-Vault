    <Grid x:Name="MemoRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="0"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid x:Name="ContentGrid" Grid.Row="2" ContextRequested="ContentGrid_ContextRequested">
                <ScrollViewer x:Name="MemoScrollViewer" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="GroupsContainer" Spacing="12" Padding="40,20,40,20">

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            
            <Canvas x:Name="DragLayer" IsHitTestVisible="False" Grid.RowSpan="3" />

                    <TextBlock x:Name="HintText"
                               Grid.Row="2"
                               Text="{x:Bind app:App.GetString(\'Memo_Empty_Tip\')}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               FontSize="13"
                               FontWeight="Light"
                               Foreground="{ThemeResource AppTextTertiaryBrush}"
                               Opacity="0.6"
                               TextWrapping="NoWrap"
                               MaxWidth="600"
                               Visibility="Collapsed" />

        <Grid x:Name="NewGroupDialogOverlay" Grid.RowSpan="3"
              Visibility="Collapsed"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
            <Grid x:Name="DialogScrim"
                  Background="#2E000000"
                  Tapped="DialogScrim_Tapped" />
            <Border x:Name="NewGroupDialog"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="480"
                    MaxHeight="620"
                    CornerRadius="24"
                    Background="{ThemeResource AppDialogBgBrush}"
                    BorderBrush="{ThemeResource AppDialogBorderBrush}"
                    BorderThickness="1"
                    Opacity="0">
                <Border.RenderTransform>
                    <CompositeTransform x:Name="NewGroupDialogTransform"
                                        ScaleX="0.92" ScaleY="0.92" TranslateY="20" />
                </Border.RenderTransform>
                <Grid Padding="28,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <TextBlock Text="{x:Bind app:App.GetString(\'Memo_Group_NewTitle\')}"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource AppPrimaryButtonBrush}" />
                        <Button x:Name="CloseDialogButton"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Width="28" Height="28"
                                Style="{StaticResource NovaraIconButtonStyle}"
                                Click="CloseDialogButton_Click">
                            <Path Data="M278.528 278.528L745.472 745.472M745.472 278.528L278.528 745.472"
                                   Stroke="{ThemeResource IconForegroundBrush}"
                                   StrokeThickness="1.8"
                                   Stretch="Uniform"
                                   Width="16" Height="16"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center" />
                        </Button>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,20,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
                                   Text="{x:Bind app:App.GetString(\'Common_Label_PickIcon\')}"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   Foreground="{ThemeResource AppTextSecondaryBrush}"
                                   Margin="0,0,0,8" />
                        <ScrollViewer Grid.Row="1"
                                      x:Name="IconScrollViewer"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled"
                                      HorizontalScrollMode="Enabled"
                                      VerticalScrollMode="Disabled"
                                      ZoomMode="Disabled"
                                      Background="Transparent"
                                      Height="56">
                            <StackPanel x:Name="IconPanel"
                                        Orientation="Horizontal"
                                        Spacing="8" />
                        </ScrollViewer>
                    </Grid>
                    <Grid Grid.Row="2" Margin="0,16,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
                                   Text="{x:Bind app:App.GetString(\'Memo_Group_NameLabel\')}"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   Foreground="{ThemeResource AppTextSecondaryBrush}"
                                   Margin="0,0,0,8" />
                        <TextBox x:Name="GroupNameTextBox"
                                 Grid.Row="1"
                                 Style="{StaticResource NovaraTextBoxStyle}"
                                 MaxLength="50"
                                 PlaceholderText="{x:Bind app:App.GetString(\'Memo_Group_NamePlaceholder\')}"
                                 TextChanged="GroupNameTextBox_TextChanged"
                                 VerticalAlignment="Center" />
                    </Grid>
                    <Grid x:Name="UngroupedListSection"
                          Grid.Row="3"
                          Margin="0,16,0,0"
                          Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
                                   Text="{x:Bind app:App.GetString(\'Memo_Entry_SelectLabel\')}"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   Foreground="{ThemeResource AppTextSecondaryBrush}"
                                   Margin="0,0,0,8" />
                        <ScrollViewer Grid.Row="1"
                                      MaxHeight="160"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Hidden">
                            <StackPanel x:Name="UngroupedEntriesPanel"
                                        Spacing="4" />
                        </ScrollViewer>
                    </Grid>
                    <Button x:Name="ConfirmButton"
                            Style="{StaticResource NovaraPrimaryButtonStyle}"
                            Grid.Row="4"
                            Margin="0,20,0,0"
                            Height="44"
                            HorizontalAlignment="Stretch"
                            CornerRadius="12"
                            FontSize="14"
                            FontWeight="Medium"
                            Click="ConfirmButton_Click">
                            <Button.RenderTransform>
                                <CompositeTransform x:Name="ConfirmButtonTransform" />
                            </Button.RenderTransform>
                            <TextBlock Text="{x:Bind app:App.GetString(\'Common_Button_Confirm\')}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="NewEntryDialogOverlay" Grid.RowSpan="3"
              Visibility="Collapsed"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
            <Grid x:Name="NewEntryDialogScrim"
                  Background="#2E000000"
                  Tapped="NewEntryDialogScrim_Tapped" />
            <Border x:Name="NewEntryDialog"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="480"
                    MaxHeight="520"
                    CornerRadius="24"
                    Background="{ThemeResource AppDialogBgBrush}"
                    BorderBrush="{ThemeResource AppDialogBorderBrush}"
                    BorderThickness="1"
                    Opacity="0">
                <Border.RenderTransform>
                    <CompositeTransform x:Name="NewEntryDialogTransform"
                                        ScaleX="0.92" ScaleY="0.92" TranslateY="20" />
                </Border.RenderTransform>
                <Grid Padding="28,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <TextBlock x:Name="NewEntryDialogTitle"
                                   Text="{x:Bind app:App.GetString(\'Memo_Entry_NewTitle\')}"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource AppPrimaryButtonBrush}" />
                        <Button x:Name="CloseNewEntryDialogButton"
                                Style="{StaticResource NovaraIconButtonStyle}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Width="28" Height="28"
                                Click="CloseNewEntryDialogButton_Click">
                            <Path Data="M278.528 278.528L745.472 745.472M745.472 278.528L278.528 745.472"
                                   Stroke="{ThemeResource IconForegroundBrush}"
                                   StrokeThickness="1.8"
                                   Stretch="Uniform"
                                   Width="16" Height="16"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center" />
                        </Button>
                    </Grid>
                    <Grid x:Name="EntryTypeSection" Grid.Row="1" Margin="0,20,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
                                   Text="{x:Bind app:App.GetString(\'Memo_Entry_TypeLabel\')}"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   Foreground="{ThemeResource AppTextSecondaryBrush}"
                                   Margin="0,0,0,8" />
                        <Button x:Name="EntryTypeButton"
                                Style="{StaticResource NovaraOutlineButtonStyle}"
                                Grid.Row="1"
                                HorizontalAlignment="Stretch"
                                Height="40"
                                CornerRadius="12"
                                Padding="14,0"
                                Foreground="{ThemeResource AppTextPrimaryBrush}"
                                BorderBrush="{ThemeResource AppPrimaryButtonBrush}"
                                Click="EntryTypeButton_Click">
                            <Grid>
                                <TextBlock x:Name="EntryTypeButtonText" Text="{x:Bind app:App.GetString(\'Memo_Entry_TypePlaceholder\')}" VerticalAlignment="Center" Foreground="{ThemeResource AppTextSecondaryBrush}" FontSize="14" />
                                <FontIcon Glyph="&#xE70D;" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                            </Grid>
