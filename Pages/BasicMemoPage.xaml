        <Grid x:Name="ApiDiagOverlay" Grid.RowSpan="3"
              Visibility="Collapsed"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
            <Grid x:Name="ApiDiagScrim"
                  Background="#2E000000"
                  Tapped="ApiDiagScrim_Tapped" />
            <Border x:Name="ApiDiagDialog"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="460"
                    CornerRadius="24"
                    Background="{ThemeResource AppDialogBgBrush}"
                    BorderBrush="{ThemeResource AppDialogBorderBrush}"
                    BorderThickness="1"
                    Opacity="0">
                <Border.RenderTransform>
                    <CompositeTransform x:Name="ApiDiagDialogTransform"
                                        ScaleX="0.92" ScaleY="0.92" TranslateY="20" />
                </Border.RenderTransform>
                <Grid Padding="28,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <TextBlock Text="{x:Bind app:App.GetString(\'Memo_ApiDiag_Title\')}"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource AppPrimaryButtonBrush}" />
                        <Button x:Name="ApiDiagDialogCloseButton"
                                Style="{StaticResource NovaraIconButtonStyle}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Width="28" Height="28"
                                Click="ApiDiagDialogCloseButton_Click">
                            <Path Data="M278.528 278.528L745.472 745.472M745.472 278.528L278.528 745.472"
                                   Stroke="{ThemeResource IconForegroundBrush}"
                                   StrokeThickness="1.8"
                                   Stretch="Uniform"
                                   Width="16" Height="16" />
                        </Button>
                    </Grid>
                    <StackPanel Grid.Row="1" Margin="0,24,0,0" Spacing="8">
                        <TextBlock x:Name="ApiDiagStatusText"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                   TextWrapping="Wrap" />
                        <Border x:Name="ApiDiagReportPanel"
                                Background="{ThemeResource AppSurfaceOverlayBrush}"
                                CornerRadius="10"
                                Padding="12,10"
                                Visibility="Collapsed">
                            <StackPanel x:Name="ApiDiagReportRows" Spacing="10" />
                        </Border>
                        <TextBlock x:Name="ApiDiagStatusDetail"
                                   FontSize="12"
                                   Foreground="{ThemeResource AppTextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   LineHeight="18" />
                    </StackPanel>
                    <TextBlock Grid.Row="2"
                               Text="{x:Bind app:App.GetString(\'Memo_ApiDiag_LatencyNote\')}"
                               FontSize="11"
                               Foreground="{ThemeResource AppTextTertiaryBrush}"
                               TextWrapping="Wrap" LineHeight="16"
                               Margin="0,20,0,0" />
                    <Grid Grid.Row="3" Margin="0,24,0,0">
                        <Button x:Name="ApiDiagCloseButton"
                                HorizontalAlignment="Right"
                                Width="140" Height="36"
                                Style="{StaticResource NovaraPrimaryButtonStyle}"
                                CornerRadius="10"
                                FontSize="14"
                                Click="ApiDiagCloseButton_Click">
                            <TextBlock Text="{x:Bind app:App.GetString(\'Common_Button_Close\')}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        
        <Grid x:Name="ApiConfirmOverlay" Grid.RowSpan="3"
              Visibility="Collapsed"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
            <Grid x:Name="ApiConfirmScrim"
                  Background="#2E000000"
                  Tapped="ApiConfirmScrim_Tapped" />
            <Border x:Name="ApiConfirmDialog"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="400"
                    CornerRadius="24"
                    Background="{ThemeResource AppDialogBgBrush}"
                    BorderBrush="{ThemeResource AppDialogBorderBrush}"
                    BorderThickness="1"
                    Opacity="0">
                <Border.RenderTransform>
                    <CompositeTransform x:Name="ApiConfirmDialogTransform"
                                        ScaleX="0.92" ScaleY="0.92" TranslateY="20" />
                </Border.RenderTransform>
                <Grid Padding="24,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <TextBlock Text="{x:Bind app:App.GetString(\'Memo_ApiConfirm_Title\')}"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource AppPrimaryButtonBrush}" />
                        <Button x:Name="ApiConfirmCloseButton"
                                Style="{StaticResource NovaraIconButtonStyle}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Width="28" Height="28"
                                Click="ApiConfirmCloseButton_Click">
                            <Path Data="M278.528 278.528L745.472 745.472M745.472 278.528L278.528 745.472"
                                   Stroke="{ThemeResource IconForegroundBrush}"
                                   StrokeThickness="1.8"
                                   Stretch="Uniform"
                                   Width="16" Height="16" />
                        </Button>
                    </Grid>
                    <TextBlock x:Name="ApiConfirmDescText"
                               Grid.Row="1"
                               Text="{x:Bind app:App.GetString(\'Memo_ApiConfirm_Desc\')}"
                               FontSize="13"
                               Foreground="{ThemeResource AppTextSecondaryBrush}"
                               TextWrapping="Wrap"
                               LineHeight="20"
                               Margin="0,16,0,0" />
                    <Grid Grid.Row="2" Margin="0,20,0,0">
                        <Button x:Name="ApiConfirmCancelButton"
                                HorizontalAlignment="Left"
                                Width="120" Height="36"
                                Style="{StaticResource NovaraOutlineButtonStyle}"
                                CornerRadius="10"
                                FontSize="14"
                                Click="ApiConfirmCancelButton_Click">
                            <TextBlock Text="{x:Bind app:App.GetString(\'Memo_ApiConfirm_Cancel\')}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                        <Button x:Name="ApiConfirmProceedButton"
                                HorizontalAlignment="Right"
                                Width="120" Height="36"
                                Style="{StaticResource NovaraPrimaryButtonStyle}"
                                CornerRadius="10"
                                FontSize="14"
                                Click="ApiConfirmProceedButton_Click">
                            <TextBlock Text="{x:Bind app:App.GetString(\'Memo_ApiConfirm_Proceed\')}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        
        <Grid x:Name="RelayProbeOverlay" Grid.RowSpan="3"
              Visibility="Collapsed"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
            <Grid x:Name="RelayProbeScrim"
                  Background="#2E000000"
                  Tapped="RelayProbeScrim_Tapped" />
            <Border x:Name="RelayProbeDialog"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="540"
                    MaxHeight="720"
                    CornerRadius="24"
                    Background="{ThemeResource AppDialogBgBrush}"
                    BorderBrush="{ThemeResource AppDialogBorderBrush}"
                    BorderThickness="1"
                    Opacity="0">
                <Border.RenderTransform>
                    <CompositeTransform x:Name="RelayProbeDialogTransform"
                                        ScaleX="0.92" ScaleY="0.92" TranslateY="20" />
                </Border.RenderTransform>
                <Grid Padding="28,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <TextBlock Text="{x:Bind app:App.GetString(\'Memo_RelayProbe_Title\')}"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource AppPrimaryButtonBrush}" />
                        <Button x:Name="RelayProbeDialogCloseButton"
                                Style="{StaticResource NovaraIconButtonStyle}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Width="28" Height="28"
                                Click="RelayProbeDialogCloseButton_Click">
                            <Path Data="M278.528 278.528L745.472 745.472M745.472 278.528L278.528 745.472"
                                   Stroke="{ThemeResource IconForegroundBrush}"
                                   StrokeThickness="1.8"
                                   Stretch="Uniform"
                                   Width="16" Height="16" />
                        </Button>
                    </Grid>
                    <StackPanel Grid.Row="1" Margin="0,20,0,0" Spacing="6">
                        <TextBlock x:Name="RelayProbeVerdictText"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="RelayProbeStatusText"
                                   FontSize="12"
                                   Foreground="{ThemeResource AppTextSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="2" Margin="0,16,0,0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="8">
                            <StackPanel x:Name="RelayProbeReportRows" Spacing="8" />
                            <TextBlock Text="{x:Bind app:App.GetString(\'Memo_RelayProbe_Disclaimer\')}"
                                       FontSize="11"
                                       Foreground="{ThemeResource AppTextTertiaryBrush}"
                                       TextWrapping="Wrap" LineHeight="16" />
                            <TextBlock Text="{x:Bind app:App.GetString(\'Memo_RelayProbe_Disclaimer2\')}"
                                       FontSize="11"
                                       Foreground="{ThemeResource AppTextTertiaryBrush}"
                                       TextWrapping="Wrap" LineHeight="16" />
                        </StackPanel>
                    </ScrollViewer>
                    <Grid Grid.Row="3" Margin="0,12,0,0">
                        <Button x:Name="RelayProbeLoadDatasetButton"
                                HorizontalAlignment="Left"
                                Width="220" Height="36"
                                Style="{StaticResource NovaraOutlineButtonStyle}"
                                CornerRadius="10"
                                Click="RelayProbeLoadDatasetButton_Click">
                            <TextBlock Text="{x:Bind app:App.GetString(\'Memo_RelayProbe_LoadDataset\')}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                        <Button x:Name="RelayProbeCloseButton"
                                HorizontalAlignment="Right"
                                Width="140" Height="36"
                                Style="{StaticResource NovaraPrimaryButtonStyle}"
                                CornerRadius="10"
                                FontSize="14"
                                Click="RelayProbeCloseButton_Click">
                            <TextBlock Text="{x:Bind app:App.GetString(\'Common_Button_Close\')}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- FocusSink: steals focus (no focus border on an invisible 0x0 button), LockScreenPage/SearchPage fix -->
        <Button x:Name="FocusSink" Width="0" Height="0" Opacity="0" IsTabStop="True" />
    </Grid>
</Page>
