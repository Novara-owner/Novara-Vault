                                Width="28" Height="28" Style="{StaticResource NovaraIconButtonStyle}"
                                Click="SealDestroyClose_Click">
                            <Path Data="M278.528 278.528L745.472 745.472M745.472 278.528L278.528 745.472"
                                  Stroke="{ThemeResource IconForegroundBrush}" StrokeThickness="1.8"
                                  Stretch="Uniform" Width="16" Height="16" />
                        </Button>
                    </Grid>

                    <TextBlock x:Name="SealDestroyTip" Grid.Row="1" Margin="0,20,0,0"
                               FontSize="14" TextWrapping="Wrap"
                               Foreground="{ThemeResource AppDangerTextBrush}" />
                    <TextBlock x:Name="SealDestroyLockedTip" Grid.Row="2" Margin="0,8,0,0"
                               FontSize="14" TextWrapping="Wrap" Visibility="Collapsed"
                               Foreground="{ThemeResource AppDangerTextBrush}" />

                    <Grid Grid.Row="3" Margin="0,20,0,0">
                        <Button x:Name="SealDestroyCancelButton" HorizontalAlignment="Left"
                                Width="160" Height="40" CornerRadius="10" FontSize="14"
                                Style="{StaticResource NovaraOutlineButtonStyle}" Click="SealDestroyCancel_Click" />
                        <services:CountdownBorder x:Name="SealDestroyCd" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="SealDestroyConfirmButton" Width="160" Height="40" FontSize="14"
                                    Style="{StaticResource NovaraDangerButtonStyle}" Click="SealDestroyConfirm_Click">
                                <TextBlock x:Name="SealDestroyConfirmText" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                        </services:CountdownBorder>
                    </Grid>
                </Grid>
            </Border>
        </Grid>


        <Grid x:Name="SealFolderModeOverlay" Visibility="Collapsed"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid x:Name="SealFolderModeScrim" Background="#2E000000" Tapped="SealFolderModeScrim_Tapped" />
            <Border x:Name="SealFolderModeDialog" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="440" CornerRadius="24"
                    Background="{ThemeResource AppDialogBgBrush}"
                    BorderBrush="{ThemeResource AppDialogBorderBrush}"
                    BorderThickness="1" Opacity="0">
                <Border.RenderTransform>
                    <CompositeTransform x:Name="SealFolderModeTransform" ScaleX="0.92" ScaleY="0.92" TranslateY="20" />
                </Border.RenderTransform>
                <Grid Padding="28,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBlock x:Name="SealFolderModeTitle" VerticalAlignment="Center"
                                   FontSize="18" FontWeight="SemiBold"
                                   Foreground="{ThemeResource AppPrimaryButtonBrush}" />
                        <Button Tag="Common_Button_Close" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Width="28" Height="28" Style="{StaticResource NovaraIconButtonStyle}"
                                Click="SealFolderModeClose_Click">
                            <Path Data="M278.528 278.528L745.472 745.472M745.472 278.528L278.528 745.472"
                                  Stroke="{ThemeResource IconForegroundBrush}" StrokeThickness="1.8"
                                  Stretch="Uniform" Width="16" Height="16" />
                        </Button>
                    </Grid>


                    <Grid Grid.Row="1" x:Name="SealFolderSeg" Height="40" Margin="0,20,0,0"
                          CornerRadius="10" BorderThickness="1"
                          Background="{ThemeResource AppSurfaceOverlayBrush}"
                          BorderBrush="{ThemeResource AppBorderBrush}">
                        <Border x:Name="SealFolderSegThumb" Height="34" HorizontalAlignment="Left"
                                VerticalAlignment="Center" CornerRadius="8" Margin="3,0,0,0"
                                Background="{ThemeResource AppPrimaryButtonBrush}"
                                IsHitTestVisible="False">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="SealFolderSegThumbTransform" X="0" />
                            </Border.RenderTransform>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="SealFolderSegRestore" Grid.Column="0"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                    BorderThickness="0" Click="SealFolderSegRestore_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent" CornerRadius="8">
                                            <ContentPresenter Content="{TemplateBinding Content}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              HorizontalContentAlignment="Center"
                                                              VerticalContentAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock x:Name="SealFolderSegRestoreText" FontSize="13" />
                            </Button>
                            <Button x:Name="SealFolderSegArchive" Grid.Column="1"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                    BorderThickness="0" Click="SealFolderSegArchive_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent" CornerRadius="8">
                                            <ContentPresenter Content="{TemplateBinding Content}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              HorizontalContentAlignment="Center"
                                                              VerticalContentAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock x:Name="SealFolderSegArchiveText" FontSize="13" />
                            </Button>
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,20,0,0">
                        <Button x:Name="SealFolderModeCancelButton" HorizontalAlignment="Left"
                                Width="160" Height="40" CornerRadius="10" FontSize="14"
                                Style="{StaticResource NovaraOutlineButtonStyle}" Click="SealFolderModeCancel_Click" />
                        <Button x:Name="SealFolderModeTakeButton" HorizontalAlignment="Right"
                                Width="160" Height="40" CornerRadius="10" FontSize="14"
                                Style="{StaticResource NovaraPrimaryButtonStyle}" Click="SealFolderModeTake_Click" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>



        <Button x:Name="SealLongOpCancelButton" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,28,28" Height="36" Padding="18,0" CornerRadius="8" FontSize="13"
                Style="{StaticResource NovaraOutlineButtonStyle}"
                Visibility="Collapsed" Click="SealLongOpCancel_Click" />


        <Button x:Name="FocusSink" Width="0" Height="0" Opacity="0" IsTabStop="False"
                HorizontalAlignment="Left" VerticalAlignment="Top" />
    </Grid>
</Page>
