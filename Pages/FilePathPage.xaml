<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Novara.Pages.FilePathPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:app="using:Novara"
    xmlns:local="using:Novara.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
    </Page.Resources>

    <Grid x:Name="ContentRoot" Background="{ThemeResource AppSurfaceBrush}" ContextRequested="RootGrid_ContextRequested">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="0" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="2" x:Name="PathScrollViewer"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="PathList"
                        Padding="40,12,40,20"
                        Spacing="12" />
        </ScrollViewer>

        
        <Canvas x:Name="DragLayer" IsHitTestVisible="False" Grid.RowSpan="3" />

        <TextBlock x:Name="EmptyHint"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextAlignment="Center"
                   Grid.Row="2"
                   FontSize="13"
                   FontWeight="Light"
                   Foreground="{ThemeResource AppTextTertiaryBrush}"
                   Opacity="0.6"
                   TextWrapping="NoWrap"
                   MaxWidth="600"
                   Visibility="Visible" />

        <Grid x:Name="NewPathOverlay"
              Grid.RowSpan="3"
              Visibility="Collapsed"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
            <Grid x:Name="NewPathScrim"
                  Background="#2E000000"
                  Tapped="NewPathScrim_Tapped" />
            <Border x:Name="NewPathDialog"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="480"
                    CornerRadius="24"
                    Background="{ThemeResource AppDialogBgBrush}"
                    BorderBrush="{ThemeResource AppDialogBorderBrush}"
                    BorderThickness="1"
                    Opacity="0">
                <Border.RenderTransform>
                    <CompositeTransform x:Name="NewPathDialogTransform"
                                        ScaleX="0.92" ScaleY="0.92" TranslateY="20" />
                </Border.RenderTransform>
                <Grid Padding="28,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBlock x:Name="NewPathDialogTitle" Text="{x:Bind app:App.GetString(\'Path_New_Title\')}"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource AppPrimaryButtonBrush}" />
                        <Button HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Width="28" Height="28"
                                Style="{StaticResource NovaraIconButtonStyle}"
                                Click="CloseNewPathDialog_Click">
                            <Path Data="M278.528 278.528L745.472 745.472M745.472 278.528L278.528 745.472"
                                  Stroke="{ThemeResource IconForegroundBrush}"
                                  StrokeThickness="1.8"
                                  Stretch="Uniform"
                                  Width="16" Height="16" />
                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="16">
                    <StackPanel Spacing="6" Margin="0,20,0,0">
                        <TextBlock Text="{x:Bind app:App.GetString(\'Common_Label_Name\')}"
                                   FontSize="12" FontWeight="Medium"
                                   Foreground="{ThemeResource AppTextSecondaryBrush}" />
                        <TextBox x:Name="NewPathNameBox"
                                 Style="{StaticResource NovaraTextBoxStyle}"
                                 MaxLength="50"
                                 PlaceholderText="{x:Bind app:App.GetString(\'Path_New_NamePlaceholder\')}"
                                 TextChanged="NewPathField_TextChanged" />
                    </StackPanel>

                    <StackPanel Spacing="6" Margin="0,16,0,0">
                        <TextBlock Text="{x:Bind app:App.GetString(\'Form_Label_Path\')}"
                                   FontSize="12" FontWeight="Medium"
                                   Foreground="{ThemeResource AppTextSecondaryBrush}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="PickFileButton"
                                    Grid.Column="0"
                                    Style="{StaticResource NovaraOutlineButtonStyle}"
                                    Height="40"
                                    HorizontalAlignment="Stretch"
                                    BorderBrush="{ThemeResource AppPrimaryButtonBrush}"
                                    CornerRadius="20"
                                    Click="PickFileButton_Click">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="6"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center">
                                    <Viewbox x:Name="PickFileIcon" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Opacity="0.6" Margin="0,1,0,0">
                                        <PathIcon x:Name="PickFilePathIcon" Foreground="{ThemeResource IconForegroundBrush}" />
                                    </Viewbox>
                                    <TextBlock Text="{x:Bind app:App.GetString(\'Path_SelectFile\')}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="PickFolderButton"
                                    Grid.Column="1"
                                    Style="{StaticResource NovaraOutlineButtonStyle}"
                                    Height="40"
                                    HorizontalAlignment="Stretch"
                                    BorderBrush="{ThemeResource AppPrimaryButtonBrush}"
                                    CornerRadius="20"
                                    Click="PickFolderButton_Click">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="6"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center">
                                    <Viewbox x:Name="PickFolderIcon" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Opacity="0.6" Margin="0,1,0,0">
                                        <PathIcon x:Name="PickFolderPathIcon" Foreground="{ThemeResource IconForegroundBrush}" />
                                    </Viewbox>
                                    <TextBlock Text="{x:Bind app:App.GetString(\'Path_SelectFolder\')}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBox x:Name="NewPathInputBox"
                                 Style="{StaticResource NovaraTextBoxStyle}"
                                 MaxLength="2000"
                                 PlaceholderText="{x:Bind app:App.GetString(\'Path_New_PathPlaceholder\')}"
                                 TextChanged="NewPathField_TextChanged" />
                    </StackPanel>

                    <StackPanel Spacing="6" Margin="0,16,0,0">
                        <TextBlock Text="{x:Bind app:App.GetString(\'Common_Label_Note\')}"
                                   FontSize="12" FontWeight="Medium"
                                   Foreground="{ThemeResource AppTextSecondaryBrush}" />
                        <TextBox x:Name="NewPathNoteBox"
                                 Style="{StaticResource NovaraTextBoxStyle}"
                                 MaxLength="500"
                                 PlaceholderText="{x:Bind app:App.GetString(\'Path_New_NotePlaceholder\')}"
                                 TextChanged="NewPathField_TextChanged" />
                    </StackPanel>
                    </StackPanel>
                    </ScrollViewer>

                    <Button x:Name="NewPathConfirmButton" Grid.Row="2" Margin="0,20,0,0" Height="44"
                            Style="{StaticResource NovaraPrimaryButtonStyle}"
                            HorizontalAlignment="Stretch"
                            CornerRadius="12"
                            FontSize="14" FontWeight="Medium"
                            Click="NewPathConfirm_Click">
                        <TextBlock Text="{x:Bind app:App.GetString(\'Common_Button_Confirm\')}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="DeleteConfirmOverlay"
              Grid.RowSpan="3"
              Visibility="Collapsed"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
            <Grid x:Name="DeleteConfirmScrim"
                  Background="#2E000000"
                  Tapped="DeleteConfirmScrim_Tapped" />
            <Border x:Name="DeleteConfirmDialog"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="400"
                    CornerRadius="24"
                    Background="{ThemeResource AppDialogBgBrush}"
                    BorderBrush="{ThemeResource AppDialogBorderBrush}"
                    BorderThickness="1"
                    Opacity="0">
                <Border.RenderTransform>
                    <CompositeTransform x:Name="DeleteConfirmDialogTransform"
                                        ScaleX="0.92" ScaleY="0.92" TranslateY="20" />
                </Border.RenderTransform>
                <Grid Padding="28,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <TextBlock Text="{x:Bind app:App.GetString(\'Dialog_Delete_Title\')}"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource AppPrimaryButtonBrush}" />
                        <Button HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Width="28" Height="28"
                                Style="{StaticResource NovaraIconButtonStyle}"
                                Click="DeleteConfirmClose_Click">
                            <Path Data="M278.528 278.528L745.472 745.472M745.472 278.528L278.528 745.472"
                                  Stroke="{ThemeResource IconForegroundBrush}"
                                  StrokeThickness="1.8"
                                  Stretch="Uniform"
                                  Width="16" Height="16" />
                        </Button>
                    </Grid>
                    <StackPanel Grid.Row="1" Margin="0,20,0,0"><TextBlock Grid.Row="1"
                               Text="{x:Bind app:App.GetString(\'Path_Delete_ConfirmTip\')}"
                               FontSize="14"
                               Foreground="{ThemeResource AppTextPrimaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0" /></StackPanel>
                    <Grid Grid.Row="2" Margin="0,20,0,0">
                        <Button HorizontalAlignment="Left"
                                Width="160" Height="36"
                                Style="{StaticResource NovaraOutlineButtonStyle}"
                                CornerRadius="10" FontSize="14"
                                Click="DeleteCancel_Click">
                            <TextBlock Text="{x:Bind app:App.GetString(\'Common_Button_Cancel\')}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                        <Button HorizontalAlignment="Right" Width="160" Height="36" Style="{StaticResource NovaraPrimaryButtonStyle}" CornerRadius="10" FontSize="14" Click="DeleteConfirmButton_Click"><TextBlock Text="{x:Bind app:App.GetString(\'Common_Button_Delete\')}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <!-- FocusSink: steals focus (no focus border on an invisible 0x0 button), LockScreenPage/SearchPage fix -->
        <Button x:Name="FocusSink" Width="0" Height="0" Opacity="0" IsTabStop="True" />
    </Grid>
</Page>
