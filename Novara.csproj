<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Build machine has only Windows SDK 10.0.26100.0 (Platform.xml); TFM must match; MinVersion 19041 guarantees Win10 2004 support -->
    <TargetFramework>net8.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Novara</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>7.0.0</Version>
    <Platforms>x64</Platforms>
    

    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- exe icon resource (taskbar / explorer / Alt+Tab, multi-size synthesized) -->
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>

    <!-- Unpackaged -->
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <AppxPackage>false</AppxPackage>
    <!-- N4-16 verified NOT dead config (2026-09-03): deleting it breaks CLI builds - WinAppSDK's
         MrtCore.PriGen.targets then resolves ExpandPriContent from the dotnet SDK dir (absent) and
         fails with MSB4062. This points PriGen at the VS install. Machine-specific by necessity;
         Vault sanitization handles the absolute-path concern. Do not remove without a build test. -->

    <!-- Self-contained -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>

    <!-- Windows SDK .NET Ref version required by WinAppSDK 1.6.250108002 (official recommendation) -->
    <WindowsSdkPackageVersion>10.0.19041.38</WindowsSdkPackageVersion>

    <!-- Exclude the StickPoc POC project dir from this project's default globs -->
    <DefaultItemExcludes>$(DefaultItemExcludes);StickPoc\**;StickNoteHost\**;Novara.Core\**;Novara.Tests\**;NovaraMCP\**</DefaultItemExcludes>

  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.2.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250108002" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.3.0" />
    <PackageReference Include="AngleSharp" Version="1.5.0" />
    <!-- CS1705 fix: H.NotifyIcon.WinUI 2.3.0 requires WinRT.Runtime 2.2.0.0; explicit CsWinRT reference unifies resolution -->
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.2.0" />
    <!-- Auto-Lock N6-05: true session-switch events (UAC/screensaver must not false-trigger) -->
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="9.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Novara.Core\Novara.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\16.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\32.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\48.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\64.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\96.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\128.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Novara-R.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\logo.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\logo.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="DiaryEditorJs\dist\tiptap.bundle.js">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>tiptap.bundle.js</Link>
    </Content>
    <Content Include="DiaryEditorJs\dist\md.bundle.js">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>md.bundle.js</Link>
    </Content>
    <Content Include="SnapshotViewer\index.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>snapshot-viewer.html</Link>
    </Content>
    
    <Content Include="ProbeDataSet.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\Fonts\Comfortaa.ttf"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="Assets\Fonts\OFL.txt"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
  </ItemGroup>
</Project>
